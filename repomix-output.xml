                className="font-bold text-[15px] mb-2 group-hover:text-[var(--coral)] transition-colors"
                style={{ color: 'var(--ink)' }}
              >
                {game.name}
              </h3>
              {game.short_description && (
                <p className="text-sm line-clamp-2" style={{ color: 'var(--muted)' }}>
                  {game.short_description}
                </p>
              )}
            </Link>
          ))}
        </div>
      )}

      {query && games.length === 0 && (
        <div
          className="rounded-2xl p-10 md:p-16 text-center max-w-lg mx-auto"
          style={{ border: '2px dashed var(--line)', background: 'var(--card)' }}
        >
          <div className="text-5xl mb-4">🔍</div>
          <p className="font-semibold mb-1" style={{ color: 'var(--ink)' }}>
            No results found
          </p>
          <p className="text-sm" style={{ color: 'var(--muted)' }}>
            Try different keywords.
          </p>
        </div>
      )}

      {!query && (
        <div
          className="rounded-2xl p-10 md:p-16 text-center max-w-lg mx-auto"
          style={{ border: '2px dashed var(--line)', background: 'var(--card)' }}
        >
          <div className="text-5xl mb-4">🎮</div>
          <p style={{ color: 'var(--muted)' }}>
            Type something above to search games.
          </p>
        </div>
      )}
    </div>
  );
}
