}
.admin-header-search {
  position: relative;
  display: flex;
  min-width: 0;
  height: 42px;
  align-items: center;
  border: 1px solid #E3E6F0;
  border-radius: 12px;
  background: #F8F9FD;
  transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
}
.admin-header-search:focus-within {
  border-color: #5B5BD6;
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(91, 91, 214, 0.14);
}
.admin-header-search > svg {
  position: absolute;
  left: 0.85rem;
  width: 17px;
  height: 17px;
  color: #64748B;
  pointer-events: none;
}
.admin-header-search input[type="search"] {
  width: 100%;
  min-width: 0;
  height: 100%;
  padding: 0 2.6rem;
  border: 0;
  border-radius: inherit;
  outline: 0;
  background: transparent;
  color: #0F172A;
  font-size: 0.86rem;
  box-shadow: none;
}
.admin-header-search input[type="search"]:focus {
  border: 0;
  outline: 0;
  box-shadow: none;
}
.admin-header-search input[type="search"]::placeholder { color: #94A3B8; }
.admin-search-clear {
  position: absolute;
  right: 0.45rem;
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
