}
.site-content .step-screenshot-overview {
  margin-top: 0.5rem;
  color: #94A3B8;
  font-size: 0.875rem;
  line-height: 1.75;
  white-space: pre-wrap;
}
@media (min-width: 768px) {
  .site-content .step-screenshot-card { padding: 1.5rem; }
  .site-content .step-screenshot-image { max-height: 600px; }
  .site-content .step-screenshot-title { font-size: 1.25rem; }
  .site-content .step-screenshot-overview { font-size: 1rem; }
}

/* Footer stays compact and visually tied to the global canvas. */
.site-content .site-footer {
  border-top: 1px solid rgba(139, 92, 246, 0.24);
  border-radius: 18px 18px 0 0;
  background: #080C16;
}
.site-content .footer-link { color: #CBD5E1; }
.site-content .footer-link:hover {
  color: #67E8F9;
  text-decoration-color: #8B5CF6;
}
.site-content .footer-cta {
  border-color: rgba(139, 92, 246, 0.25);
  background: rgba(20, 27, 45, 0.72);
}
.site-content .footer-cta .btn {
  border: 1px solid #8B5CF6;
  background: linear-gradient(115deg, #7C3AED, #8B5CF6);
  color: #fff;
}
.site-content .footer-cta .btn:hover {
  border-color: #A78BFA;
  background: linear-gradient(115deg, #8B5CF6, #A78BFA);
  color: #fff;
  box-shadow: 0 8px 24px rgba(139, 92, 246, 0.34);
}
.site-content .social-pill {
  min-height: 40px;
  align-items: center;
  border-color: rgba(148, 163, 184, 0.22);
  color: #CBD5E1;
}
.site-content .social-pill:hover {
  border-color: #8B5CF6;
  background: rgba(139, 92, 246, 0.18);
  color: #F9FAFB;
}

/* Dedicated error boundaries can be rendered outside the public layout. */
.error-screen,
.not-found-screen {
  background:
    radial-gradient(38rem 28rem at 50% 25%, rgba(139, 92, 246, 0.14), transparent 72%),
    #0A0E1A;
  color: #F9FAFB;
}
.error-screen .page-title,
.not-found-screen .page-title {
  background: linear-gradient(110deg, #C4B5FD, #67E8F9);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}
.error-screen .page-sub,
.not-found-screen .page-sub { color: #A7B3C5; }
.not-found-screen .level-tile {
  border-color: rgba(139, 92, 246, 0.4) !important;
  background: #1A2332 !important;
  color: #C4B5FD !important;
  font-family: var(--font-mono);
}
.not-found-screen .level-tile.current {
  border-color: #8B5CF6 !important;
  background: #7C3AED !important;
  color: #fff !important;
}
.error-screen .tile.stuck {
  border-color: #F59E0B;
  background: #B45309;
  color: #fff;
}
.loading-state { color: #94A3B8; }
.loading-tile {
  border-color: rgba(139, 92, 246, 0.28);
  background: linear-gradient(100deg, #141B2D 25%, #26314A 45%, #141B2D 65%);
  background-size: 220% 100%;
  box-shadow: 0 0 12px rgba(139, 92, 246, 0.12);
  animation: dark-shimmer 1.5s ease-in-out infinite;
}
@keyframes dark-shimmer {
  to { background-position: -220% 0; }
}

@media (max-width: 640px) {
  .site-content .home-hero { padding: 2.75rem 0 3rem; }
  .site-content .home-title { font-size: clamp(1.85rem, 8vw, 2.5rem); }
  .site-content .home-hero-grid { gap: 2rem; }
  .site-content .level-board { max-width: 23rem; }
  .site-content .level-grid { grid-template-columns: repeat(auto-fill, minmax(42px, 1fr)); gap: 6px; }
  .site-content .level-range-pagination-links a { min-height: 40px; }
  .site-content .search-big .search-input { min-height: 56px; padding-right: 6rem; }
  .site-content .home-actions .btn { flex: 1 1 auto; }
  .site-content .site-footer { border-radius: 14px 14px 0 0; }
}

@media (max-width: 380px) {
  .site-content .nv-bar { min-height: 56px; }
  .site-content .nv-panel.open { inset-block-start: 56px; }
  .site-content .home-actions { gap: 0.55rem; }
  .site-content .home-actions .btn { padding-inline: 0.85rem; font-size: 0.82rem; }
}

@media (prefers-reduced-motion: reduce) {
  .site-content *,
  .error-screen *,
  .not-found-screen * {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* =========================================================
   SITE-WIDE DESIGN — last block in globals.css
   Takes the home page look (flat bordered buttons, one card style,
   sky blue + orange only for emphasis) and applies it to the shared
   classes, so every page that uses them (.btn, .card, .section-title,
   .level-tile, .prose, ...) matches automatically.
   No blur, no backdrop-filter, no gradients on UI chrome.
   ========================================================= */

/* ---------- Background: calm everywhere ---------- */
body::before { display: none; }
.bg-decor { display: none; }

/* ---------- Buttons ---------- */
.btn {
  border: 1.5px solid transparent;
  border-radius: clamp(10px, 1.4vw, 12px);
  box-shadow: none;
  overflow: visible;
  transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
}
.btn::before { display: none; }
.btn-sm { border-radius: 10px; }
.btn-lg { border-radius: 12px; }

/* (search submit keeps its own centering transform) */
.btn:not(.search-submit):hover,
.btn:not(.search-submit):active {
  transform: none;
  filter: none;
  box-shadow: none;
}

.btn-primary,
.btn-teal {
  background: #0369A1;
  border-color: #0369A1;
  color: #fff;
}
.btn-primary:hover,
.btn-teal:hover { background: #075985; border-color: #075985; }
.btn-primary:active,
.btn-teal:active { background: #0C4A6E; border-color: #0C4A6E; }

.btn-secondary {
  background: #fff;
  border-color: #CBD5E1;
  color: var(--ink);
}
.btn-secondary:hover {
  background: #F0F9FF;
  border-color: #0369A1;
  color: #0369A1;
}
.btn-secondary:active { background: var(--primary-soft); }

.btn-accent {
  background: #FB923C;
  border-color: #FB923C;
  color: var(--ink);
}
.btn-accent:hover { background: #F97316; border-color: #F97316; }

.btn-youtube {
  background: #B91C1C;
  border-color: #B91C1C;
  color: #fff;
}
.btn-youtube:hover { background: #991B1B; border-color: #991B1B; }

.btn-ghost { border-color: transparent; }
.btn-ghost:hover { background: var(--primary-soft); }

/* ---------- Cards ---------- */
.card,
.card-flat {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 16px;
}
.card { box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); }
.card::before { display: none; }
.card-hover:hover {
  transform: none;
  border-color: #7DD3FC;
  box-shadow: 0 8px 20px -12px rgba(15, 23, 42, 0.22);
}

/* Game + blog cards */
.game-thumb,
.blog-thumb {
  background: var(--primary-soft);
  box-shadow: none;
  border-bottom: 1px solid var(--line-soft);
}
.game-card:hover .game-thumb img,
.blog-card:hover .blog-thumb img { transform: scale(1.03); }
.game-badge { box-shadow: none; }
.blog-meta { border-top-color: var(--line-soft); }

/* Level badge on cards: soft, turns solid on hover */
.level-badge {
  border-radius: 12px;
  background: var(--primary-soft);
  color: #0369A1;
  box-shadow: none;
}
.card:hover .level-badge {
  transform: none;
  box-shadow: none;
  background: #0369A1;
  color: #fff;
}

/* ---------- Badges ---------- */
.badge { box-shadow: none; }
.badge-white {
  background: #fff;
  border: 1px solid var(--line-soft);
  color: #0369A1;
  box-shadow: none;
}

/* ---------- Headings ---------- */
.section-title,
.page-title {
  background: none;
  color: var(--ink);
}
.section-title::before { display: none; }
.page-title { letter-spacing: -0.045em; }
.section-head {
  padding-bottom: 0.9rem;
  border-bottom: 1px solid var(--line-soft);
}

/* ---------- Level tiles (flat, no 3D) ---------- */
.level-tile {
  border: 1.5px solid var(--line);
  border-radius: 12px;
  background: #fff;
  box-shadow: none;
}
.level-tile:hover {
  transform: none;
  background: var(--primary-soft);
  border-color: #7DD3FC;
  color: #0369A1;
  box-shadow: none;
}
.level-tile:active {
  transform: none;
  background: #BAE6FD;
  box-shadow: none;
}
.level-tile.current {
  background: #0369A1;
  border-color: #0369A1;
  color: #fff;
  box-shadow: none;
}

.level-range-pagination {
  border-radius: 14px;
  background: #fff;
  box-shadow: none;
}
.level-range-pagination-links a:hover {
  border-color: #7DD3FC;
  background: var(--primary-soft);
}

/* ---------- Media + content blocks ---------- */
.video-frame {
  border: 1px solid var(--line);
  border-radius: 16px;
  background: #0F172A;
  box-shadow: none;
}
.cover-frame {
  border: 1px solid var(--line-soft);
  border-radius: 16px;
  background: var(--primary-soft);
  box-shadow: none;
}
.tip-box {
  border-radius: 16px;
  background: #FFF7ED;
  border: 1px solid #FED7AA;
  box-shadow: none;
}
.faq-item .chev { border-radius: 8px; }
.empty-state { border-radius: 16px; background: #fff; }
.ad-box { border-radius: 16px; }

/* ---------- Stats + CTA band (if used on other pages) ---------- */
.stat {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  background: #fff;
  border-radius: 14px;
  box-shadow: none;
}
.stat:hover { transform: none; box-shadow: none; }

.cta-band {
  background: #F0F9FF;
  border: 1px solid #BAE6FD;
  border-radius: 20px;
  box-shadow: none;
  text-align: center;
}
.cta-band::before,
.cta-band::after { display: none; }
.cta-band h2 { color: var(--ink); }
.cta-band p { color: var(--ink-soft); }
.cta-band .btn-accent {
  background: #0369A1;
  border-color: #0369A1;
  color: #fff;
}
.cta-band .btn-accent:hover { background: #075985; border-color: #075985; }

/* ---------- Article text (blog posts, about, policies) ---------- */
.prose img {
  border: 1px solid var(--line-soft);
  border-radius: 16px;
  box-shadow: none;
}
.prose blockquote { border-radius: 0 14px 14px 0; }
.prose code { border-radius: 6px; }
.prose pre {
  background: #0F172A;
  border-radius: 14px;
  box-shadow: none;
}
.prose th { background: var(--primary-soft); }

/* ---------- Form fields (contact page etc.) ---------- */
input[type="text"]:not(.search-input):not(.level-search-input),
input[type="url"],
input[type="email"],
input[type="password"],
input[type="number"]:not(.level-search-input),
select,
textarea {
  border: 1.5px solid #94A3B8;
  border-radius: 12px;
}

/* =========================================================
   PREMIUM LIGHT THEME
   Public-site palette and mobile navigation overrides.
   ========================================================= */
html {
  overflow-x: clip;
}
.site-content {
  --bg: #F8FAFC;
  --bg-alt: #F1F5F9;
  --surface: #FFFFFF;
  --surface-alt: #F8FAFC;
  --surface-glass: rgba(255, 255, 255, 0.88);
  --ink: #0F172A;
  --ink-soft: #334155;
  --muted: #64748B;
  --muted-light: #64748B;
  --primary: #6366F1;
  --primary-hover: #4F46E5;
  --primary-active: #4338CA;
  --primary-soft: #EEF2FF;
  --primary-light: #A5B4FC;
  --primary-dark: #4F46E5;
  --primary-deep: #4F46E5;
  --accent: #06B6D4;
  --accent-hover: #0891B2;
  --accent-soft: #ECFEFF;
  --accent-dark: #0E7490;
  --line: #E2E8F0;
  --line-soft: rgba(148, 163, 184, 0.2);
  --line-strong: #CBD5E1;
  --card: #FFFFFF;
  --card-hover: #FFFFFF;
  --background: #F8FAFC;
  --foreground: #0F172A;
  --teal: #6366F1;
  --teallight: #EEF2FF;
  --coral: #D97706;
  --coral-soft: #FFFBEB;
  --tip: #FFFBEB;
  --tipline: #FDE68A;
  --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 8px 20px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 16px 32px rgba(15, 23, 42, 0.12);
  --shadow-xl: 0 20px 40px rgba(15, 23, 42, 0.14);
  --shadow-hover: 0 16px 30px rgba(15, 23, 42, 0.12);
  background-color: #F8FAFC;
  background-image:
    radial-gradient(rgba(99, 102, 241, 0.055) 1px, transparent 1px),
    radial-gradient(rgba(6, 182, 212, 0.035) 1px, transparent 1px);
  background-position: 0 0, 12px 12px;
  background-size: 24px 24px;
  color: #0F172A;
}

.site-content h1,
.site-content h2,
.site-content h3,
.site-content h4,
.site-content h5 { color: #0F172A; }
.site-content .page-title {
  background: none;
  color: #0F172A;
}
.site-content .page-sub,
.site-content .section-sub { color: #64748B; }
.site-content .section-title::before {
  background: linear-gradient(180deg, #6366F1, #06B6D4);
  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.2);
}
.site-content :focus-visible,
.error-screen :focus-visible,
.not-found-screen :focus-visible {
  outline-color: #6366F1;
}

/* White glass navbar with an independently clickable backdrop. */
.site-content .site-nav {
  z-index: 60;
  background: rgba(255, 255, 255, 0.84);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.045);
}
.site-content .nv-brand { color: #0F172A; }
.site-content .nv-logo,
.site-content .nv-mark {
  border-color: #E0E7FF;
  box-shadow: 0 3px 12px rgba(99, 102, 241, 0.12);
}
.site-content .nv-mark { background: linear-gradient(135deg, #6366F1, #8B5CF6); }
.site-content .nv-link { color: #334155; }
.site-content .nv-link:hover { color: #4F46E5; }
.site-content .nv-link::after {
  background: linear-gradient(90deg, #6366F1, #8B5CF6);
  box-shadow: 0 0 8px rgba(99, 102, 241, 0.3);
}
.site-content .nv-link.active {
  background: #EEF2FF;
  color: #4338CA;
}
.site-content .menu-btn {
  border-color: #E2E8F0;
  background: #FFFFFF;
  color: #0F172A;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
}
.site-content .menu-lines span { background: #334155; }

.site-content .nv-backdrop {
  position: fixed;
  inset: 64px 0 0;
  z-index: 51;
  display: block;
  width: 100%;
  height: calc(100dvh - 64px);
  padding: 0;
  border: 0;
  border-radius: 0;
  background: rgba(15, 23, 42, 0.42);
  -webkit-backdrop-filter: blur(2px);
  backdrop-filter: blur(2px);
  cursor: default;
  animation: nav-backdrop-in 200ms ease both;
}
.site-content .nv-panel,
.site-content .nv-panel.open {
  position: fixed;
  inset: 64px 0 0 auto;
  z-index: 52;
  display: block;
  width: min(88vw, 26rem);
  height: calc(100dvh - 64px);
  max-height: none;
  overflow-y: auto;
  border: 0;
  border-left: 1px solid #E2E8F0;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: -16px 12px 36px rgba(15, 23, 42, 0.12);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  transform: translateX(105%);
  visibility: hidden;
  pointer-events: none;
  clip-path: inset(0 0 0 100%);
  transition:
    transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
    clip-path 280ms cubic-bezier(0.22, 1, 0.36, 1),
    visibility 280ms;
  animation: none;
}
.site-content .nv-panel.open {
  transform: translateX(0);
  visibility: visible;
  pointer-events: auto;
  clip-path: inset(0);
}
.site-content .nv-panel-body {
  width: auto;
  max-height: none;
  margin: 0;
  padding: 1.25rem 1rem 2rem;
}
.site-content .nv-mobile-links { gap: 0.4rem; }
.site-content .nv-mlink { color: #334155; }
.site-content .nv-mlink:hover {
  background: #EEF2FF;
  color: #4338CA;
}
.site-content .nv-mlink.active {
  background: #EEF2FF;
  color: #4338CA;
}
@keyframes nav-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@media (min-width: 1024px) {
  .site-content .nv-menu,
  .site-content .nv-panel,
  .site-content .nv-backdrop { display: none; }
  .site-content .nv-link.active { background: #EEF2FF; }
}
@media (max-width: 380px) {
  .site-content .nv-backdrop {
    inset-block-start: 56px;
    height: calc(100dvh - 56px);
  }
  .site-content .nv-panel,
  .site-content .nv-panel.open {
    inset-block-start: 56px;
    height: calc(100dvh - 56px);
  }
}

/* Light search fields and indigo call-to-action buttons. */
.site-content .search-input,
.site-content .search-big .search-input,
.site-content .level-search-input {
  border-color: #CBD5E1;
  background: #FFFFFF;
  color: #0F172A;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}
.site-content .search-input::placeholder,
.site-content .level-search-input::placeholder { color: #64748B; }
.site-content .search-big .search-input {
  border-color: #C7D2FE;
  box-shadow: 0 10px 28px rgba(79, 70, 229, 0.1);
}
.site-content .search-icon,
.site-content .level-search-icon { color: #64748B; }
.site-content .btn-primary {
  border-color: #6366F1;
  background: linear-gradient(110deg, #6366F1, #7C3AED);
  color: #FFFFFF;
  box-shadow: 0 5px 14px rgba(99, 102, 241, 0.2);
}
.site-content .btn-primary:hover,
.site-content .btn-primary:focus-visible {
  border-color: #4F46E5;
  background: linear-gradient(110deg, #4F46E5, #6D28D9);
  color: #FFFFFF;
  box-shadow: 0 10px 22px rgba(99, 102, 241, 0.3);
  transform: translateY(-1px);
}
.site-content .btn-secondary {
  border-color: #CBD5E1;
  background: #FFFFFF;
  color: #334155;
}
.site-content .btn-secondary:hover,
.site-content .btn-secondary:focus-visible {
  border-color: #818CF8;
  background: #EEF2FF;
  color: #4338CA;
}
.site-content .btn-accent {
  border-color: #0891B2;
  background: linear-gradient(110deg, #0891B2, #06B6D4);
  color: #FFFFFF;
}
.site-content .btn-ghost { color: #64748B; }
.site-content .btn-ghost:hover { background: #EEF2FF; color: #4338CA; }

/* White cards, clean imagery, and readable descriptions. */
.site-content .card,
.site-content .card-flat {
  border-color: #E2E8F0;
  background: #FFFFFF;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.045);
}
.site-content .card-hover:hover {
  border-color: #C7D2FE;
  box-shadow: 0 16px 28px rgba(15, 23, 42, 0.1);
  transform: translateY(-4px);
}
.site-content .game-thumb,
.site-content .blog-thumb {
  background: #F1F5F9;
  border-color: #E2E8F0;
}
.site-content .game-title,
.site-content .blog-title { color: #0F172A; }
.site-content .game-card:hover .game-title,
.site-content .blog-card:hover .blog-title { color: #4F46E5; }
.site-content .game-desc,
.site-content .blog-excerpt { color: #64748B; }
.site-content .blog-meta {
  border-color: #E2E8F0;
  color: #64748B;
}
.site-content .blog-meta span:last-child { color: #4F46E5 !important; }
.site-content .game-badge {
  border-color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.94);
  color: #4338CA;
}
.site-content .badge-primary,
.site-content .badge-teal { background: #EEF2FF; color: #4338CA; }
.site-content .badge-accent,
.site-content .badge-coral { background: #FFFBEB; color: #92400E; }

/* Subtle puzzle pattern and a soft glow behind the hero headline. */
.site-content .home-hero {
  isolation: isolate;
  background:
    radial-gradient(34rem 24rem at 18% 18%, rgba(129, 140, 248, 0.18), transparent 72%),
    radial-gradient(34rem 24rem at 84% 22%, rgba(56, 189, 248, 0.12), transparent 72%),
    linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
}
.site-content .home-hero::before {
  opacity: 0.34;
  background-image:
    radial-gradient(rgba(99, 102, 241, 0.15) 1px, transparent 1px),
    radial-gradient(rgba(6, 182, 212, 0.1) 1px, transparent 1px);
  background-size: 26px 26px, 52px 52px;
  mask-image: linear-gradient(to bottom, black, transparent 90%);
}
.site-content .home-hero-copy { position: relative; isolation: isolate; }
.site-content .home-hero-copy::before {
  content: "";
  position: absolute;
  z-index: -1;
  top: -4rem;
  left: -3rem;
  width: min(30rem, 90vw);
  height: 20rem;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(129, 140, 248, 0.2), rgba(96, 165, 250, 0.08) 42%, transparent 72%);
  filter: blur(12px);
  pointer-events: none;
