        </h1>
        <p className="text-center mb-8" style={{ color: 'var(--muted)' }}>
          Find games and walkthroughs
        </p>

        <form action="/search" method="get" className="mb-10">
          <div className="relative">
            <input
              type="text"
              name="q"
              defaultValue={query}
              placeholder="Search games..."
              autoFocus
              className="w-full px-6 py-4 pr-14 rounded-2xl text-[15px] outline-none transition-all focus:ring-2 focus:ring-[var(--coral)]"
              style={{
                background: 'var(--card)',
                border: '1.5px solid var(--line)',
