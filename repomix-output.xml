.error-screen,
.not-found-screen {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: transparent;
  color: #0F172A;
}
.error-screen::before,
.not-found-screen::before {
  content: "";
  position: absolute;
  z-index: -1;
  top: 50%;
  left: 50%;
  width: min(100% - 32px, 42rem);
  height: min(30rem, calc(100% - 32px));
  transform: translate(-50%, -50%);
  border: 1px solid #E3E6F0;
  border-radius: 24px;
  background: #FFFFFF;
  box-shadow: 0 16px 44px rgba(15, 23, 42, 0.08);
}
.error-screen .page-title,
.not-found-screen .page-title { color: #0F172A; }
.error-screen .page-sub,
.not-found-screen .page-sub { color: #64748B; }
.not-found-screen .level-tile {
  border-color: #E3E6F0 !important;
  background: #FFFFFF !important;
  color: #334155 !important;
}
.not-found-screen .level-tile.current {
  border-color: #5B5BD6 !important;
  background: #5B5BD6 !important;
  color: #FFFFFF !important;
}
.loading-state { color: #64748B; }
.loading-tile {
  border-color: #DCDDF8;
  background: linear-gradient(100deg, #F1F3FA 25%, #EEF0FF 45%, #F1F3FA 65%);
  box-shadow: 0 2px 8px rgba(91, 91, 214, 0.08);
}

@keyframes board-tile-wiggle {
  0%, 88%, 100% { transform: rotate(0); }
  91% { transform: rotate(-3deg); }
  94% { transform: rotate(3deg); }
  97% { transform: rotate(-2deg); }
}
@keyframes puzzle-drift {
  from { background-position: 0 0; }
  to { background-position: 112px 112px; }
}

@media (max-width: 1023px) {
  .site-content .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .site-content .footer-cta { grid-column: span 2; }
}
@media (max-width: 767px) {
  .site-content .home-hero { padding-block: 2.75rem; }
  .site-content .home-hero-grid { grid-template-columns: minmax(0, 1fr); }
  .site-content .home-title { font-size: clamp(2rem, 8vw, 2.8rem); }
  .site-content .level-board { width: min(100%, 30rem); margin-inline: auto; }
  .site-content .step-screenshot-card { padding: 0.75rem; }
  .site-content .step-screenshot-list { gap: 1rem; }
  .site-content .footer-grid { gap: 1.5rem 1rem; }
}
@media (max-width: 480px) {
  .site-content .nv-bar { height: 62px; min-height: 62px; }
  .site-content .nv-backdrop {
    inset-block-start: 62px;
    height: calc(100dvh - 62px);
  }
  .site-content .nv-panel.open {
    inset-block-start: 62px;
    height: auto;
    max-height: calc(100dvh - 62px);
  }
  .site-content .nv-name { font-size: 0.94rem; }
  .site-content .home-stats { width: 100%; }
  .site-content .home-stat { padding-inline: 0.25rem; }
  .site-content .footer-grid { grid-template-columns: 1fr 1fr; }
  .site-content .footer-grid > div:first-child,
  .site-content .footer-cta { grid-column: span 2; }
  .site-content .site-footer { border-radius: 20px 20px 0 0; }
}
@media (prefers-reduced-motion: reduce) {
  .site-content .home-hero::before,
  .site-content .board-tile.stuck { animation: none; }
}

