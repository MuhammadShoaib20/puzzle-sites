<file path="lib/actions/blog-images.ts">
'use server';

import { randomUUID } from 'node:crypto';
import { revalidatePath } from 'next/cache';
import { requireAuth } from '@/lib/require-auth';
import { supabaseAdmin } from '@/lib/supabase';

const MAX_IMAGE_SIZE = 5_000_000;
const MAX_TOTAL_SIZE = 49_000_000;
const ALLOWED_IMAGE_TYPES: Record<string, string> = {
  '.jpg': 'image/jpeg',
  '.png': 'image/png',
  '.webp': 'image/webp',
};

type SkippedImage = {
  fileName: string;
  reason: string;
};

export type BulkBlogImagesResult = {
  success: boolean;
  updatedSlugs?: string[];
  skippedImages?: SkippedImage[];
  error?: string;
};

export async function bulkUploadBlogImages(formData: FormData): Promise<BulkBlogImagesResult> {
  try {
    await requireAuth();

    const entries = formData.getAll('images');
    if (entries.some((entry) => typeof entry !== 'string' && !(entry instanceof File))) {
      return { success: false, error: 'Please select valid image files.' };
    }

    const files = entries.filter(
      (entry): entry is File => entry instanceof File && entry.size > 0
    );
    if (files.length === 0) {
      return { success: false, error: 'Please select at least one image.' };
    }
    if (files.reduce((total, file) => total + file.size, 0) > MAX_TOTAL_SIZE) {
      return { success: false, error: 'The total image upload size must be smaller than 49 MB.' };
    }

    const skippedImages: SkippedImage[] = [];
    const validFiles: { file: File; slug: string; extension: string }[] = [];
    const seenSlugs = new Set<string>();

    for (const file of files) {
      const extension = file.name.match(/\.[^.]+$/)?.[0].toLowerCase();
      const expectedType = extension ? ALLOWED_IMAGE_TYPES[extension] : undefined;
      if (!extension || !expectedType || (file.type && file.type !== expectedType)) {
        skippedImages.push({
          fileName: file.name || '(unnamed file)',
          reason: 'Unsupported image type. Use JPG, PNG, or WebP.',
        });
        continue;
      }
      if (file.size > MAX_IMAGE_SIZE) {
        skippedImages.push({
          fileName: file.name,
          reason: 'Image exceeds the 5 MB limit.',
        });
        continue;
      }

      const slug = file.name.slice(0, -extension.length);
      if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
        skippedImages.push({
          fileName: file.name,
          reason: 'Filename must be an exact blog slug followed by its image extension.',
        });
        continue;
      }
      if (seenSlugs.has(slug)) {
        skippedImages.push({
          fileName: file.name,
          reason: `Another selected image already uses the slug "${slug}".`,
        });
        continue;
      }

      seenSlugs.add(slug);
      validFiles.push({ file, slug, extension });
    }

    const blogsBySlug = new Map<string, { id: string; slug: string }>();
    const slugs = validFiles.map(({ slug }) => slug);
    for (let offset = 0; offset < slugs.length; offset += 100) {
      const { data: blogs, error } = await supabaseAdmin
        .from('blogs')
        .select('id, slug')
        .in('slug', slugs.slice(offset, offset + 100));

      if (error) {
        console.error('Bulk blog image lookup failed:', error);
        return { success: false, error: 'Could not look up blogs for the selected images.' };
      }
      for (const blog of blogs || []) {
        blogsBySlug.set(blog.slug, blog);
      }
    }

    const updatedSlugs: string[] = [];
    for (const { file, slug, extension } of validFiles) {
      const blog = blogsBySlug.get(slug);
      if (!blog) {
        skippedImages.push({
          fileName: file.name,
          reason: `No blog was found with the slug "${slug}".`,
        });
        continue;
      }

      const storagePath = `blogs/${slug}-${randomUUID()}${extension}`;
      const { error: uploadError } = await supabaseAdmin.storage
        .from('images')
        .upload(storagePath, file, {
          cacheControl: '31536000',
          contentType: ALLOWED_IMAGE_TYPES[extension],
          upsert: false,
        });

      if (uploadError) {
        console.error(`Bulk blog image upload failed for "${file.name}":`, uploadError);
        skippedImages.push({
          fileName: file.name,
          reason: 'Image upload to Supabase Storage failed.',
        });
        continue;
      }

      const { data: publicUrl } = supabaseAdmin.storage
        .from('images')
        .getPublicUrl(storagePath);
      const { error: updateError } = await supabaseAdmin
        .from('blogs')
        .update({ cover_image: publicUrl.publicUrl })
        .eq('id', blog.id);

      if (updateError) {
        console.error(`Bulk blog cover image update failed for "${file.name}":`, updateError);
        const { error: cleanupError } = await supabaseAdmin.storage
          .from('images')
          .remove([storagePath]);
        if (cleanupError) {
          console.error(`Bulk blog image cleanup failed for "${file.name}":`, cleanupError);
        }
        skippedImages.push({
          fileName: file.name,
          reason: 'Image uploaded, but the blog cover image could not be updated.',
        });
        continue;
      }

      updatedSlugs.push(slug);
    }

    if (updatedSlugs.length > 0) {
      revalidatePath('/blog');
      revalidatePath('/admin/blogs');
      revalidatePath('/ms-control-9x7k2p/blogs');
      revalidatePath('/blog/[slug]', 'page');
      for (const slug of updatedSlugs) {
        revalidatePath(`/blog/${slug}`);
      }
    }

    return { success: true, updatedSlugs, skippedImages };
  } catch (error) {
    console.error('Bulk blog image upload error:', error);
    if (error instanceof Error && error.message.startsWith('Unauthorized:')) {
      return { success: false, error: 'You must be signed in as an admin to upload images.' };
    }
    return { success: false, error: 'An unexpected error occurred while uploading images.' };
  }
}
</file>

<file path="lib/actions/blogs.ts">
'use server';

import { randomUUID } from 'node:crypto';
import { revalidatePath } from 'next/cache';
import Papa from 'papaparse';
import { supabaseAdmin } from '@/lib/supabase';
import { makeSlug } from '@/lib/utils';
import { requireAuth } from '@/lib/require-auth';

type ActionResult = {
  success: boolean;
  error?: string;
  fieldErrors?: {
    title?: string;
    slug?: string;
    content?: string;
  };
  data?: unknown;
};

type BulkImportResult = {
  success: boolean;
  importedCount?: number;
  error?: string;
};

export type BulkSeoUpdateResult = {
  success: boolean;
  updatedCount?: number;
  notFoundSlugs?: string[];
  error?: string;
};

const BLOG_CSV_HEADERS = [
  'title',
  'slug',
  'related_game',
  'content',
  'meta_title',
  'meta_description',
  'keywords',
  'published',
] as const;

const BLOG_SEO_CSV_HEADERS = ['slug', 'title', 'meta_title', 'meta_description'] as const;
const MAX_CSV_SIZE = 4_900_000;
const MAX_IMAGE_SIZE = 5_000_000;
const MAX_TOTAL_UPLOAD_SIZE = 49_000_000;
const IMAGE_TYPES: Record<string, string> = {
  '.jpg': 'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.png': 'image/png',
  '.webp': 'image/webp',
};

type BlogCsvRow = Record<(typeof BLOG_CSV_HEADERS)[number], string>;
type BlogSeoCsvRow = Record<(typeof BLOG_SEO_CSV_HEADERS)[number], string>;

function validateBlogData(data: {
  title: string;
  slug: string;
  content: string;
}): { valid: boolean; fieldErrors?: ActionResult['fieldErrors'] } {
  const fieldErrors: ActionResult['fieldErrors'] = {};

  // Validate title
  if (!data.title || data.title.length < 3) {
    fieldErrors.title = 'Title must be at least 3 characters.';
  } else if (data.title.length > 200) {
    fieldErrors.title = 'Title must be less than 200 characters.';
  }

  // Validate slug
  if (!data.slug || data.slug.length < 3) {
    fieldErrors.slug = 'Slug must be at least 3 characters.';
  } else if (!/^[a-z0-9-]+$/.test(data.slug)) {
    fieldErrors.slug = 'Slug can only contain lowercase letters, numbers, and hyphens.';
  }

  // Validate content
  if (!data.content || data.content.length < 10) {
    fieldErrors.content = 'Content must be at least 10 characters.';
  } else if (data.content.length > 50000) {
    fieldErrors.content = 'Content must be less than 50,000 characters.';
  }

  if (Object.keys(fieldErrors).length > 0) {
    return { valid: false, fieldErrors };
  }

  return { valid: true };
}

export async function bulkImportBlogs(formData: FormData): Promise<BulkImportResult> {
  try {
    await requireAuth();

    const files = formData.getAll('files');
    const selectedFiles = files.filter((entry): entry is File => entry instanceof File && entry.size > 0);
    if (selectedFiles.length !== files.length) {
      return { success: false, error: 'Please select valid, non-empty files.' };
    }

    const csvFiles = selectedFiles.filter((selectedFile) => /\.csv$/i.test(selectedFile.name));
    if (csvFiles.length !== 1) {
      return { success: false, error: 'Please select exactly one CSV file.' };
    }

    const file = csvFiles[0];
    if (file.size > MAX_CSV_SIZE) {
      return { success: false, error: 'CSV files must be smaller than 4.9 MB.' };
    }
    const imageFiles = selectedFiles.filter((selectedFile) => selectedFile !== file);
    if (selectedFiles.reduce((total, selectedFile) => total + selectedFile.size, 0) > MAX_TOTAL_UPLOAD_SIZE) {
      return { success: false, error: 'The total upload size must be smaller than 49 MB.' };
    }

    const csv = await file.text();
    const parsed = Papa.parse<BlogCsvRow>(csv, {
      header: true,
      skipEmptyLines: 'greedy',
    });

    if (parsed.errors.length > 0) {
      const firstError = parsed.errors[0];
      return {
        success: false,
        error: `Invalid CSV near row ${(firstError.row ?? 0) + 2}: ${firstError.message}`,
      };
    }

    const headers = parsed.meta.fields || [];
    const expectedHeaders = new Set<string>(BLOG_CSV_HEADERS);
    const unexpectedHeaders = headers.filter((header) => !expectedHeaders.has(header));
    const missingHeaders = BLOG_CSV_HEADERS.filter((header) => !headers.includes(header));
    if (
      parsed.meta.renamedHeaders &&
      Object.keys(parsed.meta.renamedHeaders).length > 0
    ) {
      return { success: false, error: 'The CSV contains duplicate column names.' };
    }
    if (unexpectedHeaders.length > 0 || missingHeaders.length > 0 || headers.length !== BLOG_CSV_HEADERS.length) {
      const details = [
        missingHeaders.length > 0 ? `missing: ${missingHeaders.join(', ')}` : '',
        unexpectedHeaders.length > 0 ? `unexpected: ${unexpectedHeaders.join(', ')}` : '',
      ].filter(Boolean);
      return {
        success: false,
        error: `The CSV must contain exactly these columns: ${BLOG_CSV_HEADERS.join(', ')}.${details.length ? ` ${details.join('; ')}.` : ''}`,
      };
    }
    if (parsed.data.length === 0) {
      return { success: false, error: 'The CSV does not contain any blog rows.' };
    }

    const rows = parsed.data.map((row, index) => ({
      rowNumber: index + 2,
      title: (row.title || '').trim(),
      slug: (row.slug || '').trim(),
      gameSlug: (row.related_game || '').trim(),
      content: (row.content || '').trim(),
      metaTitle: (row.meta_title || '').trim(),
      metaDescription: (row.meta_description || '').trim(),
      keywords: (row.keywords || '')
        .split(',')
        .map((keyword) => keyword.trim())
        .filter(Boolean),
      published: (row.published || '').trim().toLowerCase() === 'true',
    }));

    const slugs = new Set<string>();
    for (const row of rows) {
      const missingFields = [
        !row.title ? 'title' : '',
        !row.slug ? 'slug' : '',
        !row.content ? 'content' : '',
      ].filter(Boolean);
      if (missingFields.length > 0) {
        return {
          success: false,
          error: `Row ${row.rowNumber} is missing required values: ${missingFields.join(', ')}.`,
        };
      }
      if (!/^[a-z0-9-]+$/.test(row.slug)) {
        return {
          success: false,
          error: `Row ${row.rowNumber} has an invalid slug. Use lowercase letters, numbers, and hyphens only.`,
        };
      }
      if (slugs.has(row.slug)) {
        return { success: false, error: `The CSV contains the duplicate slug "${row.slug}".` };
      }
      slugs.add(row.slug);
    }

    const rowsBySlug = new Map(rows.map((row) => [row.slug, row]));
    const matchedImages = new Map<string, File>();
    for (const imageFile of imageFiles) {
      const extension = imageFile.name.match(/\.[^.]+$/)?.[0].toLowerCase();
      const expectedType = extension ? IMAGE_TYPES[extension] : undefined;
      if (!expectedType || (imageFile.type && imageFile.type !== expectedType)) {
        return {
          success: false,
          error: `Unsupported image "${imageFile.name}". Use JPG, PNG, or WebP files.`,
        };
      }
      if (imageFile.size > MAX_IMAGE_SIZE) {
        return {
          success: false,
          error: `Image "${imageFile.name}" must be smaller than 5 MB.`,
        };
      }

      const imageSlug = imageFile.name.slice(0, -extension!.length);
      if (!rowsBySlug.has(imageSlug)) {
        console.warn(`Bulk blog import: ignoring image "${imageFile.name}" because no CSV blog has that slug.`);
        continue;
      }
      if (matchedImages.has(imageSlug)) {
        return {
          success: false,
          error: `More than one image matches the blog slug "${imageSlug}". Select only one image per blog.`,
        };
      }
      matchedImages.set(imageSlug, imageFile);
    }

    const gameSlugs = [...new Set(rows.map((row) => row.gameSlug).filter(Boolean))];
    const gameIds = new Map<string, string>();
    if (gameSlugs.length > 0) {
      const { data: games, error } = await supabaseAdmin
        .from('games')
        .select('id, slug')
        .in('slug', gameSlugs);

      if (error) {
        console.error('Bulk blog import game lookup error:', error);
        return { success: false, error: 'Could not match game slugs. Please try again.' };
      }
      for (const game of games || []) {
        gameIds.set(game.slug, game.id);
      }
    }

    for (const row of rows) {
      if (row.gameSlug && !gameIds.has(row.gameSlug)) {
        return {
          success: false,
          error: `Row ${row.rowNumber} refers to unknown game slug "${row.gameSlug}".`,
        };
      }
    }

    const coverImages = new Map<string, string>();
    const uploadedImagePaths: string[] = [];
    async function cleanUpUploadedImages() {
      if (uploadedImagePaths.length === 0) return;
      const { error } = await supabaseAdmin.storage.from('images').remove(uploadedImagePaths);
      if (error) {
        console.error('Bulk blog import image cleanup failed:', error);
      }
    }

    for (const [slug, imageFile] of matchedImages) {
      const extension = imageFile.name.match(/\.[^.]+$/)?.[0].toLowerCase();
      if (!extension || !IMAGE_TYPES[extension]) {
        return { success: false, error: `Unsupported image "${imageFile.name}".` };
      }
      const storagePath = `blogs/${slug}-${randomUUID()}${extension}`;
      const { data, error } = await supabaseAdmin.storage
        .from('images')
        .upload(storagePath, imageFile, {
          cacheControl: '31536000',
          contentType: IMAGE_TYPES[extension],
          upsert: false,
        });

      if (error) {
        console.error(`Bulk blog import image upload failed for "${imageFile.name}":`, error);
        await cleanUpUploadedImages();
        return {
          success: false,
          error: `Could not upload image "${imageFile.name}". Please check the Supabase images bucket and try again.`,
        };
      }
      uploadedImagePaths.push(data.path);

      const { data: publicUrl } = supabaseAdmin.storage.from('images').getPublicUrl(data.path);
      coverImages.set(slug, publicUrl.publicUrl);
    }

    const blogsData = [];
    for (const row of rows) {
      const gameId = row.gameSlug ? gameIds.get(row.gameSlug) : null;
      blogsData.push({
        title: row.title,
        slug: row.slug,
        game_id: gameId || null,
        content: row.content,
        cover_image: coverImages.get(row.slug) || null,
        meta_title: row.metaTitle || null,
        meta_description: row.metaDescription || null,
        keywords: row.keywords,
        published: row.published,
      });
    }

    const { error } = await supabaseAdmin
      .from('blogs')
      .upsert(blogsData, { onConflict: 'slug' });

    if (error) {
      console.error('Bulk blog import database error:', error);
      await cleanUpUploadedImages();
      return { success: false, error: 'Failed to import blogs. Please check the CSV and try again.' };
    }

    revalidatePath('/blog');
    revalidatePath('/admin/blogs');
    revalidatePath('/ms-control-9x7k2p/blogs');
    revalidatePath('/sitemap.xml');
    for (const slug of slugs) {
      revalidatePath(`/blog/${slug}`);
    }

    return { success: true, importedCount: blogsData.length };
  } catch (error) {
    console.error('Bulk blog import error:', error);
    if (error instanceof Error && error.message.startsWith('Unauthorized:')) {
      return { success: false, error: 'You must be signed in as an admin to import blogs.' };
    }
    return { success: false, error: 'An unexpected error occurred while importing blogs.' };
  }
}

export async function bulkUpdateBlogSEO(formData: FormData): Promise<BulkSeoUpdateResult> {
  const updatedSlugs: string[] = [];

  try {
    await requireAuth();

    const file = formData.get('file');
    if (!(file instanceof File) || file.size === 0) {
      return { success: false, error: 'Please select a non-empty CSV file.' };
    }
    if (!/\.csv$/i.test(file.name)) {
      return { success: false, error: 'Please select a CSV file.' };
    }
    if (file.size > MAX_CSV_SIZE) {
      return { success: false, error: 'CSV files must be smaller than 4.9 MB.' };
    }

    const parsed = Papa.parse<BlogSeoCsvRow>(await file.text(), {
      header: true,
      skipEmptyLines: 'greedy',
    });

    if (parsed.errors.length > 0) {
      const firstError = parsed.errors[0];
      return {
        success: false,
        error: `Invalid CSV near row ${(firstError.row ?? 0) + 2}: ${firstError.message}`,
      };
    }

    const headers = parsed.meta.fields || [];
    const expectedHeaders = new Set<string>(BLOG_SEO_CSV_HEADERS);
    const unexpectedHeaders = headers.filter((header) => !expectedHeaders.has(header));
    const missingHeaders = BLOG_SEO_CSV_HEADERS.filter((header) => !headers.includes(header));
    if (parsed.meta.renamedHeaders && Object.keys(parsed.meta.renamedHeaders).length > 0) {
      return { success: false, error: 'The CSV contains duplicate column names.' };
    }
    if (headers.length !== BLOG_SEO_CSV_HEADERS.length || unexpectedHeaders.length || missingHeaders.length) {
      const details = [
        missingHeaders.length > 0 ? `missing: ${missingHeaders.join(', ')}` : '',
        unexpectedHeaders.length > 0 ? `unexpected: ${unexpectedHeaders.join(', ')}` : '',
      ].filter(Boolean);
      return {
        success: false,
        error: `The CSV must contain exactly these columns: ${BLOG_SEO_CSV_HEADERS.join(', ')}.${details.length ? ` ${details.join('; ')}.` : ''}`,
      };
    }
    if (parsed.data.length === 0) {
      return { success: false, error: 'The CSV does not contain any blog rows.' };
    }

    const rows = parsed.data.map((row, index) => ({
      rowNumber: index + 2,
      slug: (row.slug || '').trim(),
      title: (row.title || '').trim(),
      metaTitle: (row.meta_title || '').trim(),
      metaDescription: (row.meta_description || '').trim(),
    }));
    const slugs = new Set<string>();

    for (const row of rows) {
      if (!row.slug || !row.title) {
        return {
          success: false,
          error: `Row ${row.rowNumber} must include both slug and title.`,
        };
      }
      if (!/^[a-z0-9-]+$/.test(row.slug)) {
        return {
          success: false,
          error: `Row ${row.rowNumber} has an invalid slug. Use lowercase letters, numbers, and hyphens only.`,
        };
      }
      if (slugs.has(row.slug)) {
        return { success: false, error: `The CSV contains the duplicate slug "${row.slug}".` };
      }
      slugs.add(row.slug);
    }

    const notFoundSlugs: string[] = [];
    for (const row of rows) {
      const { data, error } = await supabaseAdmin
        .from('blogs')
        .update({
          title: row.title,
          meta_title: row.metaTitle,
          meta_description: row.metaDescription,
        })
        .eq('slug', row.slug)
        .select('slug')
        .maybeSingle();

      if (error) {
        console.error(`Bulk blog SEO update failed for "${row.slug}":`, error);
        revalidateBlogPaths(...updatedSlugs);
        return {
          success: false,
          updatedCount: updatedSlugs.length,
          error: `Failed to update row ${row.rowNumber} (${row.slug}). ${updatedSlugs.length} earlier row(s) were updated.`,
        };
      }
      if (data) {
        updatedSlugs.push(data.slug);
      } else {
        notFoundSlugs.push(row.slug);
      }
    }

    revalidatePath('/ms-control-9x7k2p/blogs');
    revalidateBlogPaths(...updatedSlugs);
    return {
      success: true,
      updatedCount: updatedSlugs.length,
      notFoundSlugs,
    };
  } catch (error) {
    console.error('Bulk blog SEO update error:', error);
    revalidateBlogPaths(...updatedSlugs);
    if (error instanceof Error && error.message.startsWith('Unauthorized:')) {
      return { success: false, error: 'You must be signed in as an admin to update blog SEO.' };
    }
    return { success: false, updatedCount: updatedSlugs.length, error: 'Failed to update blog SEO.' };
  }
}

async function checkSlugExists(slug: string, excludeId?: string): Promise<boolean> {
  const query = supabaseAdmin
    .from('blogs')
    .select('id')
    .eq('slug', slug);

  if (excludeId) {
    query.neq('id', excludeId);
  }

  const { data } = await query.limit(1);
  return (data || []).length > 0;
}

async function generateUniqueSlug(baseSlug: string, excludeId?: string): Promise<string> {
  let slug = baseSlug;
  let counter = 1;

  while (await checkSlugExists(slug, excludeId)) {
    slug = `${baseSlug}-${counter}`;
    counter++;
  }

  return slug;
}

function revalidateBlogPaths(...slugs: string[]) {
  revalidatePath('/');
  revalidatePath('/blog');
  revalidatePath('/sitemap.xml');
  for (const slug of new Set(slugs)) {
    revalidatePath(`/blog/${slug}`);
  }
}

export async function createBlog(formData: FormData): Promise<ActionResult> {
  try {
    await requireAuth();

    const title = (formData.get('title') as string || '').trim();
    let slug = ((formData.get('slug') as string) || makeSlug(title)).trim();
    const game_id = (formData.get('game_id') as string) || null;
    const content = (formData.get('content') as string || '').trim();
    const cover_image = (formData.get('cover_image') as string) || null;
    const meta_title = (formData.get('meta_title') as string) || null;
    const meta_description = (formData.get('meta_description') as string) || null;
    const keywordsRaw = formData.get('keywords') as string;
    const keywords = keywordsRaw
      ? keywordsRaw.split(',').map((k) => k.trim()).filter(Boolean)
      : [];
    const published = formData.get('published') === 'on';

    // Server-side validation
    const validation = validateBlogData({ title, slug, content });
    if (!validation.valid) {
      return { success: false, error: 'Please fix the errors below.', fieldErrors: validation.fieldErrors };
    }

    // Check for duplicate slug
    if (await checkSlugExists(slug)) {
      slug = await generateUniqueSlug(slug);
    }

    const { data: inserted, error } = await supabaseAdmin.from('blogs').insert({
      title,
      slug,
      game_id: game_id || null,
      content,
      cover_image,
      meta_title,
      meta_description,
      keywords,
      published,
    }).select().single();

    if (error) {
      console.error('Supabase error:', error);
      if (error.code === '23505') {
        return { success: false, error: 'A blog with this slug already exists. Please choose a different one.' };
      }
      return { success: false, error: 'Failed to create blog. Please try again.' };
    }
    revalidatePath('/ms-control-9x7k2p/blogs');
    revalidateBlogPaths(slug);
    return { success: true, data: inserted };
  } catch (error) {
    console.error('Create blog error:', error);
    return { success: false, error: 'An unexpected error occurred. Please try again.' };
  }
}

export async function updateBlog(id: string, formData: FormData): Promise<ActionResult> {
  try {
    await requireAuth();

    const title = (formData.get('title') as string || '').trim();
    let slug = ((formData.get('slug') as string) || makeSlug(title)).trim();
    const game_id = (formData.get('game_id') as string) || null;
    const content = (formData.get('content') as string || '').trim();
    const cover_image = (formData.get('cover_image') as string) || null;
    const meta_title = (formData.get('meta_title') as string) || null;
    const meta_description = (formData.get('meta_description') as string) || null;
    const keywordsRaw = formData.get('keywords') as string;
    const keywords = keywordsRaw
      ? keywordsRaw.split(',').map((k) => k.trim()).filter(Boolean)
      : [];
    const published = formData.get('published') === 'on';

    // Server-side validation
    const validation = validateBlogData({ title, slug, content });
    if (!validation.valid) {
      return { success: false, error: 'Please fix the errors below.', fieldErrors: validation.fieldErrors };
    }

    // Check for duplicate slug (excluding current blog)
    if (await checkSlugExists(slug, id)) {
      slug = await generateUniqueSlug(slug, id);
    }

    const { data: existing, error: lookupError } = await supabaseAdmin
      .from('blogs')
      .select('slug')
      .eq('id', id)
      .maybeSingle();

    if (lookupError) {
      console.error('Supabase error:', lookupError);
      return { success: false, error: 'Failed to find blog. Please try again.' };
    }
    if (!existing) {
      return { success: false, error: 'Blog not found.' };
    }

    const { error } = await supabaseAdmin
      .from('blogs')
      .update({
        title,
        slug,
        game_id: game_id || null,
        content,
        cover_image,
        meta_title,
        meta_description,
        keywords,
        published,
      })
      .eq('id', id);

    if (error) {
      console.error('Supabase error:', error);
      if (error.code === '23505') {
        return { success: false, error: 'A blog with this slug already exists. Please choose a different one.' };
      }
      return { success: false, error: 'Failed to update blog. Please try again.' };
    }
    revalidatePath('/ms-control-9x7k2p/blogs');
    revalidateBlogPaths(existing.slug, slug);
    return { success: true };
  } catch (error) {
    console.error('Update blog error:', error);
    return { success: false, error: 'An unexpected error occurred. Please try again.' };
  }
}

export async function deleteBlog(id: string): Promise<ActionResult> {
  try {
    await requireAuth();

    const { data: blog, error: lookupError } = await supabaseAdmin
      .from('blogs')
      .select('slug')
      .eq('id', id)
      .maybeSingle();

    if (lookupError) {
      console.error('Supabase error:', lookupError);
      return { success: false, error: 'Failed to find blog. Please try again.' };
    }
    if (!blog) {
      return { success: false, error: 'Blog not found.' };
    }

    const { error } = await supabaseAdmin.from('blogs').delete().eq('id', id);

    if (error) {
      console.error('Supabase error:', error);
      return { success: false, error: 'Failed to delete blog. Please try again.' };
    }
    revalidatePath('/ms-control-9x7k2p/blogs');
    revalidateBlogPaths(blog.slug);
    return { success: true };
  } catch (error) {
    console.error('Delete blog error:', error);
    return { success: false, error: 'An unexpected error occurred. Please try again.' };
  }
}
