.admin-profile-trigger:hover,
.admin-profile-trigger[aria-expanded="true"] {
  border-color: #E3E6F0;
  background: #F8F9FD;
}
.admin-avatar {
  display: grid;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  place-items: center;
  border: 1px solid #DCDDF8;
  border-radius: 50%;
  background: #EEF0FF;
  color: #4A4AC4;
