.admin-profile-menu > a:hover,
.admin-profile-menu > button:hover { background: #EEF0FF; color: #4A4AC4; }
.admin-profile-menu > .admin-profile-signout {
  margin-top: 0.35rem;
  border-top: 1px solid #E3E6F0;
  border-radius: 0;
  color: #B91C1C;
}
.admin-menu-toggle { display: none; }
.admin-shell > .admin-side {
  position: sticky;
  top: 76px;
  grid-column: 1;
  grid-row: 2;
  width: 264px;
  height: calc(100vh - 76px);
  min-height: 440px;
  align-self: start;
  border-right: 1px solid #E3E6F0;
}
.admin-shell > .admin-main {
  grid-column: 2;
  grid-row: 2;
  min-width: 0;
  min-height: calc(100vh - 76px);
}
.admin-side .admin-brand-row { min-height: 68px; }
.admin-side .admin-brand-row .brand-mark { width: 34px; height: 34px; font-size: 1rem; }
.admin-side .admin-brand-row .brand > span:last-child { font-size: 0.9rem; }
.admin-side .admin-nav::before {
  content: "WORKSPACE";
  padding: 0.2rem 0.75rem 0.45rem;
  color: #94A3B8;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}
.admin-drawer { display: none; }

@media (max-width: 1199px) {
  .admin-shell > .admin-topbar {
    grid-template-columns: minmax(190px, 0.8fr) minmax(200px, 1fr) auto auto;
    gap: 0.8rem;
    padding-inline: 1rem;
  }
  .admin-header-actions { display: none; }
}
@media (max-width: 1023px) {
  .admin-shell {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(calc(100vh - 76px), auto);
  }
  .admin-shell > .admin-topbar {
    grid-template-columns: minmax(170px, 1fr) minmax(180px, 1.15fr) auto auto;
    grid-row: 1;
  }
  .admin-shell > .admin-side { display: none; }
  .admin-shell > .admin-main {
    grid-column: 1;
    grid-row: 2;
    min-height: calc(100vh - 76px);
  }
  .admin-menu-toggle {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid #E3E6F0;
    border-radius: 11px;
    background: #FFFFFF;
    color: #0F172A;
  }
  .admin-menu-toggle .menu-lines span { background: #334155; }
  .admin-drawer {
    position: fixed;
    z-index: 80;
    inset: 0;
    display: block;
    visibility: hidden;
    transition: visibility 0s linear 280ms;
  }
  .admin-drawer.open { visibility: visible; transition-delay: 0s; }
  .admin-drawer .backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgba(15, 23, 42, 0.48);
    cursor: default;
    opacity: 0;
    transition: opacity 240ms ease;
  }
  .admin-drawer.open .backdrop { opacity: 1; }
  .admin-drawer .panel {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    width: min(320px, 88vw);
    flex-direction: column;
    border: 0;
    border-right: 1px solid #E3E6F0;
    background: #FFFFFF;
    box-shadow: 18px 0 40px rgba(15, 23, 42, 0.16);
    transform: translateX(-100%);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .admin-drawer.open .panel { transform: none; }
  .admin-drawer .admin-nav { min-height: 0; }
  .admin-drawer-signout {
    padding: 0.7rem 0.8rem;
    border-top: 1px solid #E3E6F0;
  }
  .admin-drawer-signout .admin-link { color: #B91C1C; }
  .admin-drawer-signout .admin-link .ico { background: #FEF2F2; color: #B91C1C; }
}
@media (max-width: 767px) {
  .admin-shell > .admin-topbar {
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-rows: 48px 42px;
    gap: 0.6rem;
    min-height: 116px;
    padding: 0.55rem 0.85rem 0.65rem;
  }
  .admin-shell { grid-template-rows: auto minmax(calc(100vh - 116px), auto); }
  .admin-shell > .admin-topbar > .brand { grid-column: 1; grid-row: 1; }
  .admin-topbar .brand-mark { width: 38px; height: 38px; flex-basis: 38px; }
  .admin-header-brand-copy strong { font-size: 0.83rem; }
  .admin-header-brand-copy > span { font-size: 0.65rem; }
  .admin-profile { grid-column: 2; grid-row: 1; }
  .admin-profile-trigger { min-height: 40px; padding: 0.15rem; }
  .admin-profile-copy,
  .admin-profile-chevron { display: none; }
  .admin-avatar { width: 34px; height: 34px; flex-basis: 34px; }
  .admin-menu-toggle { grid-column: 3; grid-row: 1; }
  .admin-header-search { grid-column: 1 / -1; grid-row: 2; height: 42px; }
  .admin-header-search input[type="search"] { font-size: 16px; }
  .admin-header-actions { display: none; }
  .admin-profile-menu { top: calc(100% + 0.65rem); }
  .admin-shell > .admin-main { min-height: calc(100vh - 116px); }
}
@media (max-width: 380px) {
  .admin-header-brand-copy strong { max-width: 14ch; }
  .admin-shell > .admin-topbar { padding-inline: 0.7rem; }
}
</file>

