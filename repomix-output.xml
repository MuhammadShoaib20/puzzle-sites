  return (
    <div className="container-page py-12 md:py-16 animate-fade-in-up">
      <div className="max-w-2xl mx-auto">
        <h1 className="text-3xl md:text-4xl font-bold mb-3 text-center" style={{ color: 'var(--tealdark)' }}>
