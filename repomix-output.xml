}
.admin-search-heading {
  display: block;
  padding: 0.6rem 0.7rem 0.45rem;
  color: #64748B;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.admin-search-result {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) 18px;
  min-height: 42px;
  align-items: center;
  gap: 0.55rem;
  padding: 0.45rem 0.7rem;
  border-radius: 9px;
  color: #334155;
  font-size: 0.86rem;
  font-weight: 650;
