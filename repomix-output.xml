}
.admin-profile-copy { display: grid; gap: 0.12rem; white-space: nowrap; }
.admin-profile-copy strong { color: #0F172A; font-size: 0.78rem; font-weight: 750; }
.admin-profile-copy > span { color: #64748B; font-size: 0.7rem; }
.admin-profile-chevron { color: #64748B; font-size: 1rem; }
.admin-profile-menu {
  position: absolute;
  z-index: 90;
  top: calc(100% + 0.55rem);
  right: 0;
  width: 230px;
  padding: 0.45rem;
  border: 1px solid #E3E6F0;
  border-radius: 14px;
  background: #FFFFFF;
  box-shadow: 0 10px 24px -12px rgba(15, 23, 42, 0.22);
}
.admin-profile-menu-heading {
  display: grid;
  gap: 0.2rem;
  padding: 0.7rem 0.75rem 0.8rem;
  border-bottom: 1px solid #E3E6F0;
}
.admin-profile-menu-heading strong { color: #0F172A; font-size: 0.86rem; }
.admin-profile-menu-heading > span { color: #64748B; font-size: 0.75rem; }
.admin-profile-menu > a,
.admin-profile-menu > button {
  display: flex;
  width: 100%;
  min-height: 40px;
  align-items: center;
  gap: 0.6rem;
  padding: 0.55rem 0.75rem;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #334155;
  cursor: pointer;
  font: inherit;
  font-size: 0.84rem;
  text-align: left;
  text-decoration: none;
