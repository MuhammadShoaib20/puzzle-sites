}

* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body), system-ui, -apple-system, 'Segoe UI', sans-serif;
  line-height: 1.7;
  overflow-x: hidden;
  position: relative;
  font-feature-settings: 'cv01' on, 'cv02' on;
}

/* ---- Page background design: subtle gradient ---- */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(14, 165, 233, 0.08), transparent 50%),
    radial-gradient(ellipse 60% 40% at 100% 50%, rgba(99, 102, 241, 0.05), transparent 50%),
    radial-gradient(ellipse 60% 40% at 0% 80%, rgba(251, 146, 60, 0.04), transparent 50%);
}

/* Floating puzzle pieces layer */
.bg-decor {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.bg-piece {
  position: absolute;
  animation: pieceFloat 11s ease-in-out infinite;
  will-change: transform;
}
.bg-piece svg { display: block; width: 100%; height: 100%; }
.bg-piece.sky svg path { fill: #7DD3FC; }
.bg-piece.indigo svg path { fill: #A5B4FC; }
.bg-piece.orange svg path { fill: #FDBA74; }
.bg-piece { opacity: 0.34; }
@media (max-width: 760px) {
  .bg-piece { opacity: 0.22; }
  .bg-piece:nth-child(n + 5) { display: none; }
}
@keyframes pieceFloat {
  0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)); }
  50% { transform: translateY(-18px) rotate(calc(var(--r, 0deg) + 7deg)); }
}
.site-content { position: relative; z-index: 1; }

h1, h2, h3, h4, h5 {
  font-family: var(--font-display), system-ui, sans-serif;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--ink);
  text-wrap: balance;
  font-feature-settings: 'ss01' on, 'ss02' on;
}

img { max-width: 100%; }

::selection { background: var(--primary); color: #fff; }

:focus-visible {
  outline: 3px solid var(--primary-light);
  outline-offset: 2px;
  border-radius: 8px;
}

/* ---------- Scrollbar ---------- */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg-alt); }
::-webkit-scrollbar-thumb {
  background: var(--primary-light);
  border-radius: 10px;
  border: 2px solid var(--bg-alt);
}
::-webkit-scrollbar-thumb:hover { background: var(--primary); }

/* =========================================================
   LAYOUT
   ========================================================= */
.container-page,
.container-narrow {
  margin-left: auto;
  margin-right: auto;
  padding-left: clamp(16px, 4vw, 28px);
  padding-right: clamp(16px, 4vw, 28px);
  width: 100%;
}
.container-page { max-width: 1240px; }
.container-narrow { max-width: 820px; }

.section { margin-bottom: clamp(3.5rem, 7vw, 6rem); }

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
}
.section-title {
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.2;
  background: linear-gradient(135deg, var(--ink) 0%, var(--ink-soft) 100%);
  -webkit-background-clip: text;
  background-clip: text;
}
.section-sub {
  color: var(--muted);
  font-size: 0.97rem;
  margin-top: 0.35rem;
  font-weight: 500;
  line-height: 1.6;
}

.page-title {
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.04em;
  background: linear-gradient(135deg, var(--ink) 0%, var(--primary-deep) 100%);
  -webkit-background-clip: text;
  background-clip: text;
}
.page-sub {
  color: var(--ink-soft);
  font-size: clamp(1rem, 2.2vw, 1.15rem);
  margin-top: 0.75rem;
  max-width: 42rem;
  line-height: 1.7;
  font-weight: 500;
}

.layout-2col {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2rem;
  align-items: start;
}
@media (min-width: 1024px) {
  .layout-2col {
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 2.5rem;
  }
}
.sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
@media (min-width: 1024px) {
  .sidebar { position: sticky; top: 92px; }
}

.link-arrow {
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 0.92rem;
  transition: color 150ms, transform 150ms;
  display: inline-flex;
  gap: 4px;
}
.link-arrow:hover { color: var(--accent-dark); transform: translateX(3px); }

/* =========================================================
   BUTTONS — Modern clean style
   ========================================================= */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0.9rem 1.5rem;
  border-radius: 12px;
  font-family: var(--font-display), system-ui, sans-serif;
  font-weight: 700;
  font-size: 0.94rem;
  line-height: 1;
  letter-spacing: -0.02em;
  cursor: pointer;
  border: 0;
  text-decoration: none;
  white-space: nowrap;
  position: relative;
  transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease, background 180ms ease;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}
.btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-sm { padding: 0.65rem 1.05rem; font-size: 0.86rem; border-radius: 10px; }
.btn-lg { padding: 1.1rem 1.9rem; font-size: 1.02rem; border-radius: 14px; }
.btn-block { width: 100%; }

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #38BDF8 0%, #0EA5E9 100%);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}
.btn-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
  pointer-events: none;
}
.btn-primary:hover {
  transform: translateY(-2px);
  filter: brightness(1.05);
  box-shadow: var(--shadow-lg);
}
.btn-primary:active {
  transform: translateY(0);
  box-shadow: var(--shadow-sm);
}

.btn-secondary {
  color: var(--ink);
  background: #fff;
  border: 1.5px solid var(--line);
  box-shadow: var(--shadow-sm);
}
.btn-secondary:hover {
  transform: translateY(-2px);
  color: var(--primary-deep);
  border-color: var(--primary-light);
  box-shadow: var(--shadow-md);
}
.btn-secondary:active {
  transform: translateY(0);
  box-shadow: var(--shadow-sm);
}

.btn-accent {
  color: #fff;
  background: linear-gradient(135deg, #FDBA74 0%, #FB923C 100%);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}
.btn-accent::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
  pointer-events: none;
}
.btn-accent:hover {
  transform: translateY(-2px);
  filter: brightness(1.04);
  box-shadow: var(--shadow-lg);
}
.btn-accent:active { transform: translateY(0); box-shadow: var(--shadow-sm); }

.btn-youtube {
  color: #fff;
  background: linear-gradient(135deg, #F87171 0%, #EF4444 100%);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}
.btn-youtube::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
  pointer-events: none;
}
.btn-youtube:hover { transform: translateY(-2px); filter: brightness(1.05); box-shadow: var(--shadow-lg); }
.btn-youtube:active { transform: translateY(0); box-shadow: var(--shadow-sm); }

/* Legacy names */
.btn-teal { color: #fff; background: linear-gradient(180deg, #38BDF8, #0EA5E9); box-shadow: 0 5px 0 #0369A1; }
.btn-teal:active { transform: translateY(4px); box-shadow: 0 1px 0 #0369A1; }
.btn-ghost { background: transparent; color: var(--ink); margin-bottom: 0; }
.btn-ghost:hover { background: var(--primary-soft); }

/* =========================================================
   CARDS
   ========================================================= */
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  position: relative;
  transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 240ms ease, border-color 240ms ease;
}
.card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 50%);
  opacity: 0;
  transition: opacity 240ms ease;
  pointer-events: none;
}
.card-hover:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary-light);
}
.card-hover:hover::before {
  opacity: 1;
}
.card-flat {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
}

.game-card { display: flex; flex-direction: column; height: 100%; }
.game-thumb {
  position: relative;
  aspect-ratio: 16 / 10;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, #E0F2FE 0%, #E0E7FF 100%);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
}
.game-thumb img { transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); object-fit: cover; }
.game-card:hover .game-thumb img { transform: scale(1.05); }
.game-badge { position: absolute; left: 12px; bottom: 12px; box-shadow: var(--shadow-md); }
.game-title {
  font-weight: 700;
  font-size: 1.05rem;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 160ms;
  letter-spacing: -0.02em;
  line-height: 1.3;
}
.game-card:hover .game-title { color: var(--primary-dark); }
.game-desc {
  color: var(--muted);
  font-size: 0.89rem;
  margin-top: 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.55;
  font-weight: 500;
}

.blog-card { display: flex; flex-direction: column; height: 100%; }
.blog-thumb {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  display: grid;
  place-items: center;
  font-size: 2.75rem;
  background: linear-gradient(135deg, #E0F2FE 0%, #E0E7FF 100%);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
}
.blog-thumb img { object-fit: cover; transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
.blog-card:hover .blog-thumb img { transform: scale(1.06); }
.blog-body { padding: 1.35rem; display: flex; flex-direction: column; flex: 1; }
.blog-title {
  font-weight: 700;
  font-size: 1.08rem;
  line-height: 1.35;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color 160ms;
  letter-spacing: -0.02em;
}
.blog-card:hover .blog-title { color: var(--primary-dark); }
.blog-excerpt {
  color: var(--muted);
  font-size: 0.92rem;
  margin: 0.6rem 0 1.1rem;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.65;
  font-weight: 500;
}
.blog-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.82rem;
  color: var(--muted-light);
  padding-top: 0.85rem;
  border-top: 1px solid var(--line-soft);
  margin-top: auto;
  font-weight: 600;
}

.level-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.15rem;
}
.level-badge {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: #fff;
  font-family: var(--font-display), sans-serif;
  font-weight: 800;
  font-size: 1.1rem;
  background: linear-gradient(135deg, #38BDF8, #0284C7);
  box-shadow: var(--shadow-md);
  transition: transform 220ms ease;
  letter-spacing: -0.02em;
}
.card:hover .level-badge { transform: translateY(-2px) rotate(-4deg); box-shadow: var(--shadow-lg); }

/* =========================================================
   BADGES
   ========================================================= */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-size: 0.76rem;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.02em;
  box-shadow: var(--shadow-sm);
}
.badge-primary, .badge-teal { background: var(--primary-soft); color: var(--primary-deep); }
.badge-accent, .badge-coral { background: var(--accent-soft); color: var(--accent-dark); }
.badge-white { background: rgba(255,255,255,0.95); color: var(--primary-deep); box-shadow: var(--shadow-md); }
.badge-ink { background: var(--ink); color: #fff; }

/* =========================================================
   NAVBAR
   ========================================================= */
.site-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--surface-glass);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--line);
  box-shadow: var(--shadow-sm);
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  min-height: 72px;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  font-family: var(--font-display), sans-serif;
  font-weight: 800;
  font-size: 1.2rem;
  color: var(--ink);
  letter-spacing: -0.03em;
  white-space: nowrap;
  transition: transform 180ms;
}
.brand:hover { transform: scale(1.02); }
.brand-mark {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  font-size: 26px;
  background: linear-gradient(135deg, #38BDF8 0%, #0EA5E9 100%);
  box-shadow: var(--shadow-md);
  position: relative;
}
.brand-mark::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, transparent 50%);
  pointer-events: none;
}
.nav-link {
  padding: 0.6rem 1.1rem;
  border-radius: 12px;
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--ink-soft);
  transition: background 160ms, color 160ms;
}
.nav-link:hover { background: var(--primary-soft); color: var(--primary-deep); }
.nav-link.active { background: var(--primary-soft); color: var(--primary-deep); }

.menu-btn {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1.5px solid var(--line);
  background: #fff;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: transform 150ms, box-shadow 150ms, background 150ms;
  flex-shrink: 0;
}
.menu-btn:hover { background: var(--bg-alt); }
.menu-btn:active { transform: scale(0.95); }
.menu-lines { position: relative; width: 18px; height: 14px; }
.menu-lines span {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2.5px;
  border-radius: 2px;
  background: var(--ink);
  transition: transform 260ms ease, opacity 200ms ease, top 260ms ease;
}
.menu-lines span:nth-child(1) { top: 0; }
.menu-lines span:nth-child(2) { top: 6px; }
.menu-lines span:nth-child(3) { top: 12px; }
.menu-lines.open span:nth-child(1) { top: 6px; transform: rotate(45deg); }
.menu-lines.open span:nth-child(2) { opacity: 0; }
.menu-lines.open span:nth-child(3) { top: 6px; transform: rotate(-45deg); }

.mobile-panel {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 320ms cubic-bezier(0.22, 1, 0.36, 1);
}
.mobile-panel.open { grid-template-rows: 1fr; }
.mobile-panel-inner { overflow: hidden; }
.mobile-links { display: grid; gap: 0.35rem; padding: 0.25rem 0 1.25rem; }
.mobile-links .nav-link { font-size: 1rem; padding: 0.85rem 1rem; border-radius: 14px; }

/* Search inputs */
.search-wrap { position: relative; width: 100%; }
.search-input {
  width: 100%;
  padding: 0.75rem 1rem 0.75rem 2.8rem;
  border-radius: 12px;
  font-size: 0.9rem;
  outline: none;
  background: #fff;
  border: 1.5px solid var(--line);
  color: var(--ink);
  transition: border-color 160ms, box-shadow 160ms, background 160ms;
}
.search-input::placeholder { color: var(--muted-light); }
.search-input:focus {
  background: #fff;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
}
.search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted-light);
  pointer-events: none;
}
.search-big .search-input {
  padding: 1.1rem 8.5rem 1.1rem 3.3rem;
  font-size: 1rem;
  background: #fff;
  box-shadow: var(--shadow-lg);
  border-radius: 16px;
}
.search-big .search-icon { left: 1.3rem; }
.search-big .search-submit {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
}
.search-big .search-submit.btn { margin-bottom: 0; }
@media (max-width: 520px) {
  .search-big .search-input { padding-right: 1.25rem; }
  .search-big .search-submit { display: none; }
}

/* =========================================================
   HERO
   ========================================================= */
.hero {
  position: relative;
  overflow: hidden;
  padding: clamp(5rem, 12vw, 8rem) 0 clamp(5rem, 10vw, 7rem);
  background: linear-gradient(180deg, rgba(224, 242, 254, 0.5) 0%, rgba(248, 250, 252, 0) 75%);
}
.hero-dots {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(14, 165, 233, 0.12) 1.5px, transparent 1.5px);
  background-size: 36px 36px;
  -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  pointer-events: none;
}
.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  animation: blob 25s ease-in-out infinite;
}
.hero-blob.b1 { width: 500px; height: 500px; background: #7DD3FC; top: -150px; left: -120px; opacity: 0.45; }
.hero-blob.b2 { width: 400px; height: 400px; background: #C7D2FE; top: 80px; right: -100px; opacity: 0.4; animation-delay: -8s; }
.hero-blob.b3 { width: 350px; height: 350px; background: #FED7AA; bottom: -120px; left: 50%; opacity: 0.3; animation-delay: -12s; }

.hero-title {
  font-size: clamp(2.8rem, 8vw, 5.2rem);
  font-weight: 800;
  line-height: 1.02;
  letter-spacing: -0.05em;
  max-width: 18ch;
  margin-left: auto;
  margin-right: auto;
  background: linear-gradient(135deg, var(--ink) 0%, var(--primary-deep) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  text-shadow: 0 4px 20px rgba(14, 165, 233, 0.15);
}
.hero-sub {
  color: var(--ink-soft);
  font-size: clamp(1.1rem, 2.6vw, 1.35rem);
  max-width: 38rem;
  margin: 1.75rem auto 0;
  line-height: 1.75;
  font-weight: 500;
}

/* Hero level-tile strip — the thing this site is about */
.tile-strip {
  display: flex;
  justify-content: center;
  gap: clamp(0.5rem, 1.8vw, 1rem);
  margin-top: clamp(2.5rem, 6vw, 3.5rem);
  flex-wrap: wrap;
}
.tile {
  width: clamp(44px, 9vw, 62px);
  height: clamp(44px, 9vw, 62px);
  border-radius: clamp(14px, 2.5vw, 18px);
  display: grid;
  place-items: center;
  font-family: var(--font-display), sans-serif;
  font-weight: 800;
  font-size: clamp(0.95rem, 2.6vw, 1.25rem);
  color: var(--primary-deep);
  background: #fff;
  border: 1.5px solid var(--line);
  box-shadow: var(--shadow-md);
  animation: tilePop 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  transition: transform 200ms ease, box-shadow 200ms ease;
}
.tile:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
}
.tile.solved { background: linear-gradient(135deg, #38BDF8, #0EA5E9); color: #fff; border-color: #0284C7; box-shadow: var(--shadow-md); }
.tile.stuck {
  background: linear-gradient(135deg, #FDBA74, #FB923C);
  color: #fff;
  border-color: #EA580C;
  box-shadow: var(--shadow-md);
  animation: tilePop 600ms cubic-bezier(0.34, 1.56, 0.64, 1) both, wiggle 2.8s ease-in-out 1.4s infinite;
}

/* Stats */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(0.6rem, 2.5vw, 1.2rem);
  max-width: 600px;
  margin: clamp(2.5rem, 5vw, 3rem) auto 0;
}
.stat {
  background: var(--surface-glass);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 1rem 0.75rem;
  box-shadow: var(--shadow-sm);
  transition: transform 200ms ease, box-shadow 200ms ease;
}
.stat:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}
.stat b {
  display: block;
  font-family: var(--font-display), sans-serif;
  font-size: clamp(1.35rem, 3.6vw, 1.8rem);
  color: var(--primary-deep);
  line-height: 1.1;
}
.stat span { font-size: 0.8rem; color: var(--muted); font-weight: 600; }

/* CTA band */
.cta-band {
  position: relative;
  overflow: hidden;
  border-radius: 24px;
  padding: clamp(2rem, 6vw, 3.5rem);
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #0284C7 0%, #0EA5E9 50%, #38BDF8 100%);
  box-shadow: var(--shadow-xl);
}
.cta-band::before, .cta-band::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.cta-band::before { width: 280px; height: 280px; top: -100px; right: -70px; }
.cta-band::after { width: 200px; height: 200px; bottom: -90px; left: -50px; }
.cta-band h2 { color: #fff; font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 800; position: relative; margin-bottom: 0.75rem; }
.cta-band p { color: #E0F2FE; margin: 0 auto 1.75rem; max-width: 34rem; position: relative; line-height: 1.7; }
.cta-band .btn { position: relative; }

/* =========================================================
   LEVEL TILES (grids of numbers)
   ========================================================= */
.level-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(54px, 1fr));
  gap: 0.65rem;
}
.level-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  border-radius: 14px;
  font-family: var(--font-display), sans-serif;
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--ink);
  background: #fff;
  border: 1.5px solid var(--line);
  box-shadow: 0 3px 0 var(--line);
  transition: transform 140ms, background 140ms, box-shadow 140ms, border-color 140ms, color 140ms;
}
.level-tile:hover {
  transform: translateY(-3px);
  background: var(--primary-soft);
  border-color: var(--primary-light);
  color: var(--primary-deep);
  box-shadow: 0 6px 0 var(--primary-light);
}
.level-tile:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--line); }
.level-tile.current {
  color: #fff;
  background: linear-gradient(180deg, #38BDF8, #0EA5E9);
  border-color: #0284C7;
  box-shadow: 0 4px 0 #0369A1, 0 10px 16px -6px rgba(14,165,233,.55);
}

/* Pager (prev / next) */
.pager { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }
.pager-item { padding: 1rem 1.15rem; display: block; }
.pager-item small { color: var(--muted); font-size: 0.78rem; display: block; margin-bottom: 0.15rem; }
.pager-item strong { font-family: var(--font-display), sans-serif; color: var(--ink); }
.pager-item.next { text-align: right; }

/* =========================================================
   MEDIA / CONTENT
   ========================================================= */
.video-frame {
  aspect-ratio: 16 / 9;
  border-radius: 22px;
  overflow: hidden;
  background: #071A2E;
  box-shadow: var(--shadow-lg), 0 0 0 5px #fff, 0 0 0 6px var(--line);
}
.video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }

.cover-frame {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: 22px;
  overflow: hidden;
  background: linear-gradient(135deg, #BAE6FD, #C7D2FE);
  box-shadow: var(--shadow-md);
}
.cover-frame img { object-fit: cover; }

.tip-box {
  border-radius: 20px;
  padding: 1.15rem 1.3rem;
  background: linear-gradient(180deg, #FFF7ED, #FFEFD9);
  border: 1px solid #FED7AA;
  box-shadow: 0 4px 0 #FED7AA;
}
.tip-box h3 { font-size: 1rem; margin-bottom: 0.4rem; color: #9A3412; }

.faq-item { padding: 1.1rem 1.3rem; cursor: pointer; }
.faq-item summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  font-weight: 700;
  color: var(--ink);
  cursor: pointer;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item .chev {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 0.8rem;
  transition: transform 280ms ease, background 200ms;
}
.faq-item[open] { border-color: var(--primary-light); }
.faq-item[open] .chev { transform: rotate(180deg); background: var(--primary); color: #fff; }
.faq-item p { margin-top: 0.8rem; color: var(--ink-soft); line-height: 1.75; font-size: 0.95rem; }

.breadcrumb {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.15rem;
  font-size: 0.85rem;
  color: var(--muted);
}
.breadcrumb a { padding: 0.15rem 0.35rem; border-radius: 8px; transition: color 150ms, background 150ms; }
.breadcrumb a:hover { color: var(--primary-dark); background: var(--primary-soft); }
.crumb { display: inline-flex; align-items: center; gap: 0.15rem; }
.crumb-sep { color: var(--muted-light); padding: 0 0.15rem; }
.crumb-current { color: var(--ink); font-weight: 600; padding: 0.15rem 0.35rem; }

.empty-state {
  border: 2px dashed var(--line);
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24px;
  padding: clamp(2rem, 7vw, 4rem) 1.5rem;
  text-align: center;
}
.empty-state .emoji { font-size: 3rem; margin-bottom: 0.75rem; }

/* Ads */
.ad-wrap { margin: 1.5rem 0; }
.ad-label {
  text-align: center;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  color: var(--muted-light);
  margin-bottom: 0.4rem;
}
.ad-box {
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--bg-alt);
  border: 1px dashed var(--line);
}

/* =========================================================
   FOOTER
   ========================================================= */
.site-footer {
  position: relative;
  margin-top: clamp(4rem, 8vw, 6rem);
  padding: clamp(3rem, 7vw, 4.5rem) 0 2rem;
  color: #CBD5E1;
  background: linear-gradient(180deg, #0F172A 0%, #020617 100%);
}
.site-footer::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--primary), transparent);
}
.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
  margin-bottom: 3rem;
}
@media (min-width: 640px) { .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1024px) { .footer-grid { grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr)); gap: 3rem; } }
.footer-grid.no-cat { }
@media (min-width: 1024px) { .footer-grid.no-cat { grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr)); } }
.footer-title { color: #fff; font-family: var(--font-display), sans-serif; font-weight: 700; margin-bottom: 1rem; font-size: 1.05rem; letter-spacing: -0.02em; background: linear-gradient(135deg, #fff 0%, #E0F2FE 100%); -webkit-background-clip: text; background-clip: text; }
.footer-links { display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.95rem; }
.footer-link { transition: color 150ms, transform 150ms; display: inline-block; font-weight: 500; }
.footer-link:hover { color: #fff; transform: translateX(4px); }
.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 1.75rem;
  text-align: center;
  font-size: 0.87rem;
  color: #94A3B8;
  line-height: 1.6;
}
.social-pill {
  display: inline-flex;
  align-items: center;
  padding: 0.5rem 1rem;
  border-radius: 999px;
  font-size: 0.87rem;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: background 160ms, transform 160ms;
}
.social-pill:hover { background: var(--primary); color: #fff; transform: translateY(-2px); }

/* =========================================================
   PROSE
   ========================================================= */
.prose { color: var(--ink-soft); font-size: 1.02rem; line-height: 1.8; }
.prose > :first-child { margin-top: 0; }
.prose > :last-child { margin-bottom: 0; }
.prose h2 {
  font-size: clamp(1.4rem, 3.2vw, 1.75rem);
  font-weight: 800;
  margin: 2.5rem 0 1rem;
  color: var(--ink);
  letter-spacing: -0.03em;
  line-height: 1.25;
}
.prose h3 { font-size: clamp(1.15rem, 2.6vw, 1.3rem); font-weight: 700; margin: 2rem 0 0.75rem; color: var(--ink); letter-spacing: -0.02em; line-height: 1.35; }
.prose h4 { font-size: 1.1rem; font-weight: 700; margin: 1.6rem 0 0.6rem; letter-spacing: -0.01em; }
.prose p { margin-bottom: 1.25rem; line-height: 1.85; }
.prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1.25rem; line-height: 1.85; }
.prose ul { list-style: disc; }
.prose ol { list-style: decimal; }
.prose li { margin-bottom: 0.5rem; }
.prose li::marker { color: var(--primary); font-weight: 700; }
.prose a { color: var(--primary-dark); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1.5px; transition: color 150ms; font-weight: 600; }
.prose a:hover { color: var(--accent-dark); }
.prose img { max-width: 100%; height: auto; border-radius: 20px; margin: 2rem 0; box-shadow: var(--shadow-lg); }
.prose strong, .prose b { font-weight: 700; color: var(--ink); }
.prose blockquote {
  margin: 1.75rem 0;
  padding: 1.25rem 1.5rem;
  border-left: 4px solid var(--primary);
  background: var(--primary-soft);
  border-radius: 0 18px 18px 0;
  color: var(--ink);
  font-weight: 500;
}
.prose code {
  background: var(--primary-soft);
  padding: 3px 8px;
  border-radius: 8px;
  font-size: 0.9em;
  color: var(--primary-deep);
  font-weight: 600;
}
.prose pre { background: #0B2540; color: #E0F2FE; padding: 1.25rem 1.5rem; border-radius: 18px; overflow-x: auto; margin-bottom: 1.25rem; box-shadow: var(--shadow-md); }
.prose pre code { background: transparent; color: inherit; padding: 0; }
.prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
.prose table { display: block; overflow-x: auto; width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
.prose th, .prose td { border: 1px solid var(--line); padding: 0.75rem 1rem; text-align: left; }
.prose th { background: var(--primary-soft); color: var(--ink); font-weight: 700; }

/* =========================================================
   FORM FIELDS (public + admin)
   ========================================================= */
input[type="text"], input[type="url"], input[type="email"], input[type="password"], input[type="number"], select, textarea {
  background: #fff;
  transition: border-color 160ms, box-shadow 160ms;
}
input[type="text"]:focus, input[type="url"]:focus, input[type="email"]:focus, input[type="password"]:focus, input[type="number"]:focus, select:focus, textarea:focus {
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.15);
}

/* =========================================================
   ANIMATION
   ========================================================= */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in-up { animation: fadeInUp 520ms cubic-bezier(0.22, 1, 0.36, 1) both; }

@keyframes tilePop {
  from { opacity: 0; transform: translateY(18px) scale(0.7); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes wiggle {
  0%, 100% { transform: rotate(0); }
  8% { transform: rotate(-9deg); }
  16% { transform: rotate(8deg); }
  24% { transform: rotate(-5deg); }
  32% { transform: rotate(0); }
}
@keyframes blob {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -24px) scale(1.08); }
  66% { transform: translate(-22px, 22px) scale(0.95); }
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.skeleton {
  background: linear-gradient(90deg, var(--bg-alt) 25%, #fff 50%, var(--bg-alt) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 14px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* =========================================================
   BASE FIX — Tailwind v4 default border is currentColor
   ========================================================= */
@layer base {
  *, ::after, ::before, ::backdrop, ::file-selector-button {
    border-color: var(--line);
  }
}

/* =========================================================
   ADMIN SHELL (plain CSS — no responsive utility dependence)
   ========================================================= */
.admin-shell { display: flex; min-height: 100vh; position: relative; z-index: 1; }
.admin-side {
  width: 268px;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #0B2540 0%, #071A2E 100%);
  border-right: 1px solid rgba(255,255,255,0.06);
}
.admin-topbar { display: none; }
.admin-drawer { display: none; }
.admin-main { flex: 1; min-width: 0; }

@media (max-width: 1023px) {
  .admin-shell { flex-direction: column; }
  .admin-side { display: none; }
  .admin-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 0.7rem 1rem;
    background: #0B2540;
    box-shadow: 0 8px 20px -12px rgba(0,0,0,0.6);
  }
  .admin-drawer {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
    transition: visibility 0s linear 320ms;
  }
  .admin-drawer.open { visibility: visible; transition-delay: 0s; }
  .admin-drawer .backdrop {
    position: absolute;
    inset: 0;
    background: rgba(7, 26, 46, 0.6);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .admin-drawer.open .backdrop { opacity: 1; }
  .admin-drawer .panel {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: min(300px, 85vw);
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #0B2540 0%, #071A2E 100%);
    transform: translateX(-100%);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 20px 0 50px -20px rgba(0,0,0,0.6);
  }
  .admin-drawer.open .panel { transform: none; }
}

.admin-brand-row { padding: 1.25rem 1.15rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
.admin-brand-row .brand { color: #fff; }
.admin-nav { flex: 1; padding: 1rem 0.8rem; display: flex; flex-direction: column; gap: 0.4rem; overflow-y: auto; }
.admin-foot { padding: 0.8rem; border-top: 1px solid rgba(255,255,255,0.08); display: flex; flex-direction: column; gap: 0.3rem; }
.admin-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  width: 100%;
  padding: 0.7rem 0.85rem;
  border-radius: 14px;
  font-weight: 700;
  font-size: 0.95rem;
  color: #B4CCE0;
  background: transparent;
  border: 0;
  cursor: pointer;
  text-align: left;
  transition: background 160ms, color 160ms, transform 160ms;
}
.admin-link .ico {
  width: 32px; height: 32px;
  display: grid; place-items: center;
  border-radius: 10px;
  background: rgba(255,255,255,0.08);
  font-size: 1rem;
  flex-shrink: 0;
}
.admin-link:hover { background: rgba(255,255,255,0.09); color: #fff; }
.admin-link.active {
  color: #fff;
  background: linear-gradient(180deg, #38BDF8, #0EA5E9);
  box-shadow: 0 4px 0 #0369A1, 0 12px 20px -10px rgba(14,165,233,0.7);
  margin-bottom: 4px;
}
.admin-link.active .ico { background: rgba(255,255,255,0.22); }
.admin-link.danger:hover { background: #EF4444; color: #fff; }

/* Page chrome */
.admin-page { padding: clamp(1.1rem, 3.5vw, 2.25rem); max-width: 1280px; margin: 0 auto; width: 100%; }
.admin-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
.admin-title { font-size: clamp(1.6rem, 3.5vw, 2.15rem); font-weight: 800; }
.admin-sub { color: var(--muted); font-size: 0.95rem; margin-top: 0.25rem; }
.admin-back { font-size: 0.85rem; font-weight: 700; color: var(--primary-dark); }
.admin-back:hover { color: var(--accent-dark); }

.admin-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; margin-bottom: 1.75rem; }
.admin-stat { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.3rem; }
.admin-stat-icon {
  width: 56px; height: 56px;
  border-radius: 18px;
  display: grid; place-items: center;
  font-size: 1.6rem;
  flex-shrink: 0;
  box-shadow: 0 4px 0 rgba(0,0,0,0.18);
}
.admin-stat-num { font-family: var(--font-display), sans-serif; font-weight: 800; font-size: 2.1rem; line-height: 1; color: var(--ink); }
.admin-stat-label { color: var(--muted); font-size: 0.88rem; margin-top: 0.3rem; font-weight: 600; }
.admin-stat-go { margin-left: auto; color: var(--muted-light); font-size: 1.2rem; transition: transform 200ms, color 200ms; }
.admin-stat:hover .admin-stat-go { transform: translateX(4px); color: var(--primary-dark); }

.admin-panel { padding: clamp(1.1rem, 3vw, 1.6rem); }
.admin-panel h2 { font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; }
.admin-panel-tint { background: linear-gradient(135deg, #E0F2FE 0%, #EEF2FF 100%); border-color: #BAE6FD; }

/* Tables */
.admin-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.admin-table { width: 100%; min-width: 620px; border-collapse: collapse; }
.admin-table th {
  text-align: left;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--primary-deep);
  background: var(--primary-soft);
  padding: 0.8rem 1rem;
  white-space: nowrap;
}
.admin-table th.right, .admin-table td.right { text-align: right; }
.admin-table td { padding: 0.9rem 1rem; border-top: 1px solid var(--line-soft); font-size: 0.92rem; vertical-align: middle; }
.admin-table tbody tr { transition: background 150ms; }
.admin-table tbody tr:hover { background: #F7FBFF; }
.admin-table .name { font-weight: 700; color: var(--ink); }
.admin-table .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.82rem; color: var(--muted); }
.admin-actions { display: inline-flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; justify-content: flex-end; }

.pill { display: inline-flex; align-items: center; padding: 0.22rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
.pill-green { background: #DCFCE7; color: #15803D; }
.pill-gray { background: #EEF2F7; color: #475569; }
.pill-blue { background: var(--primary-soft); color: var(--primary-deep); }

/* Small action buttons */
.act {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 0.42rem 0.8rem;
  border-radius: 10px;
  font-size: 0.8rem; font-weight: 700; line-height: 1;
  border: 0; cursor: pointer;
  transition: transform 140ms, filter 140ms, background 140ms;
}
.act:hover { transform: translateY(-1px); filter: brightness(0.96); }
.act:disabled { opacity: 0.6; cursor: not-allowed; }
.act-edit { background: var(--primary-soft); color: var(--primary-deep); }
.act-levels { background: #D1FAE5; color: #047857; }
.act-del { background: #FEE2E2; color: #B91C1C; }
.act-del.solid { background: #EF4444; color: #fff; }
.act-ghost { background: #EEF2F7; color: #475569; }

/* Level cards (admin) */
.admin-level-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.85rem; }
.admin-level { padding: 0.9rem; }
.admin-level .num { font-family: var(--font-display), sans-serif; font-weight: 800; font-size: 1.5rem; color: var(--primary-dark); line-height: 1; }
.admin-level .vid { font-size: 0.75rem; color: var(--muted); margin: 0.5rem 0 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.admin-alert { border-radius: 16px; padding: 1rem 1.2rem; margin-bottom: 1.5rem; font-size: 0.9rem; background: #FFF7ED; border: 1px solid #FED7AA; color: #9A3412; }
.admin-alert code { display: block; margin-top: 0.5rem; padding: 0.5rem 0.7rem; background: #FFEDD5; border-radius: 10px; font-size: 0.82rem; overflow-x: auto; }

/* Make the old admin forms (Tailwind boxes) match the new look */
.admin-main .bg-white.rounded-xl { border-radius: 22px; box-shadow: var(--shadow-sm); border-color: var(--line); }
.admin-main .bg-white.rounded-xl.p-12 { padding: 3rem 1.5rem; }
.admin-main > .p-8 { padding: clamp(1.1rem, 3.5vw, 2.25rem); }
.admin-main input[type="text"], .admin-main input[type="url"], .admin-main input[type="number"],
.admin-main input[type="email"], .admin-main input[type="password"], .admin-main select, .admin-main textarea {
  border-color: var(--line);
  border-radius: 12px;
}
