}
.admin-search-result > span:first-child {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 8px;
  background: #EEF0FF;
}
.admin-search-result > span:last-child { color: #94A3B8; text-align: right; }
.admin-search-result:hover,
.admin-search-result:focus-visible {
  outline: 0;
  background: #F4F5FF;
  color: #4A4AC4;
}
.admin-search-empty {
  padding: 0.65rem 0.7rem;
  color: #64748B;
  font-size: 0.83rem;
}
.admin-header-actions {
  display: flex;
  align-items: center;
  gap: 0.55rem;
}
.admin-header-actions .btn {
  min-height: 40px;
  padding: 0.55rem 0.85rem;
  white-space: nowrap;
}
.admin-profile { position: relative; }
.admin-profile-trigger {
  display: flex;
  min-height: 46px;
  align-items: center;
  gap: 0.6rem;
  padding: 0.25rem 0.45rem;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
  color: #334155;
