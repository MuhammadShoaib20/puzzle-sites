<file path="components/AccessKeyScreen.tsx">
'use client';

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';

const ACCESS_KEY_COOKIE = 'admin_access_key';
const COOKIE_EXPIRY = 24 * 60 * 60 * 1000; // 24 hours

type Props = {
  correctKey: string;
  onSuccess: () => void;
};

export function useAccessKey(): boolean {
  const [hasAccess, setHasAccess] = useState(false);

  useEffect(() => {
    const checkAccess = () => {
      const cookie = document.cookie
        .split('; ')
        .find((row) => row.startsWith(`${ACCESS_KEY_COOKIE}=`));
      if (cookie) {
        const value = cookie.split('=')[1];
        const timestamp = parseInt(value, 10);
        if (Date.now() < timestamp) {
          setHasAccess(true);
        } else {
          // Cookie expired
          document.cookie = `${ACCESS_KEY_COOKIE}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
          setHasAccess(false);
        }
      }
    };

    checkAccess();
  }, []);

  return hasAccess;
}

export function setAccessKeyCookie() {
  const expiry = Date.now() + COOKIE_EXPIRY;
  document.cookie = `${ACCESS_KEY_COOKIE}=${expiry}; expires=${new Date(expiry).toUTCString()}; path=/; SameSite=Strict; Secure`;
}

export function clearAccessKeyCookie() {
  document.cookie = `${ACCESS_KEY_COOKIE}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/`;
}

export default function AccessKeyScreen({ correctKey, onSuccess }: Props) {
  const [key, setKey] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const router = useRouter();

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    // Simulate slight delay to prevent timing attacks
    await new Promise((resolve) => setTimeout(resolve, 500));

    if (key === correctKey) {
      setAccessKeyCookie();
      onSuccess();
    } else {
      setError('Invalid access key');
      setKey('');
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center p-4" style={{ backgroundColor: 'var(--bg)' }}>
      <div className="w-full max-w-md">
        <div className="card p-8" style={{ boxShadow: 'var(--shadow-sm)' }}>
          <div className="text-center mb-8">
            <div className="w-16 h-16 mx-auto mb-4 rounded-xl flex items-center justify-center" style={{ backgroundColor: 'var(--primary-soft)', color: 'var(--primary)' }}>
              <svg className="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h1 className="text-2xl font-bold mb-2" style={{ color: 'var(--ink)' }}>Access Required</h1>
            <p style={{ color: 'var(--muted)' }}>Enter your access key to continue</p>
          </div>

          <form onSubmit={handleSubmit} className="space-y-4">
            <div>
              <label htmlFor="access-key" className="block text-sm font-medium mb-2" style={{ color: 'var(--ink-soft)' }}>
                Access Key
              </label>
              <input
                id="access-key"
                type="password"
                value={key}
                onChange={(e) => setKey(e.target.value)}
                placeholder="Enter 8-digit code"
                maxLength={8}
                className="w-full px-4 py-3"
                style={{ borderRadius: '12px', border: '1.5px solid #94A3B8', background: '#fff', color: 'var(--ink)' }}
                disabled={loading}
                autoFocus
              />
            </div>

            {error && (
              <div className="p-3 rounded-lg" style={{ background: '#FEF2F2', border: '1px solid #FCA5A5' }}>
                <p className="text-sm" style={{ color: '#B91C1C' }}>{error}</p>
              </div>
            )}

            <button
              type="submit"
              disabled={loading || key.length !== 8}
              className="btn btn-primary btn-block"
            >
              {loading ? 'Verifying...' : 'Continue'}
            </button>
          </form>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="components/ActivityLog.tsx">
'use client';

import { useState } from 'react';
import type { ActivityEntry } from '@/lib/db';

type Props = {
  activities: ActivityEntry[];
  summary: {
    totalLoginsToday: number;
    failedAttemptsToday: number;
    lastSuccessfulLogin: string | null;
  };
  suspiciousIPs: string[];
  adminPath: string;
};

type ActivityFilter = 'all' | 'logins' | 'failures' | 'admin_actions';

export default function ActivityLog({ activities, summary, suspiciousIPs, adminPath }: Props) {
  const [filter, setFilter] = useState<ActivityFilter>('all');

  const filteredActivities = activities.filter((activity) => {
    if (filter === 'all') return true;
    if (filter === 'logins') return activity.type === 'login';
    if (filter === 'failures') return activity.status === 'failure';
    if (filter === 'admin_actions') return activity.type === 'admin_action';
    return true;
  });

  const formatRelativeTime = (dateString: string) => {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'Just now';
    if (diffMins < 60) return `${diffMins} min ago`;
    if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
    return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
  };

  const formatAbsoluteTime = (dateString: string) => {
    const date = new Date(dateString);
    return date.toLocaleString();
  };

  const parseUserAgent = (userAgent: string) => {
    let browser = 'Unknown';
    let device = 'Unknown';

    if (userAgent.includes('Chrome')) browser = 'Chrome';
    else if (userAgent.includes('Firefox')) browser = 'Firefox';
    else if (userAgent.includes('Safari') && !userAgent.includes('Chrome')) browser = 'Safari';
    else if (userAgent.includes('Edge')) browser = 'Edge';

    if (userAgent.includes('iPhone') || userAgent.includes('iPad')) device = 'iOS';
    else if (userAgent.includes('Android')) device = 'Android';
    else if (userAgent.includes('Windows')) device = 'Windows';
    else if (userAgent.includes('Mac')) device = 'Mac';
    else if (userAgent.includes('Linux')) device = 'Linux';

    return { browser, device };
  };

  const getActionIcon = (action: string) => {
    if (action.includes('login')) return '🔐';
    if (action.includes('logout')) return '🚪';
    if (action.includes('password')) return '🔑';
    if (action.includes('create')) return '➕';
    if (action.includes('update') || action.includes('edit')) return '✏️';
    if (action.includes('delete')) return '🗑️';
    return '📋';
  };

  return (
    <div className="space-y-6">
      {/* Summary Card */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="card p-4">
          <div className="text-sm text-gray-600 mb-1">Total Logins Today</div>
          <div className="text-2xl font-bold text-sky-600">{summary.totalLoginsToday}</div>
        </div>
        <div className="card p-4">
          <div className="text-sm text-gray-600 mb-1">Failed Attempts Today</div>
          <div className="text-2xl font-bold text-red-600">{summary.failedAttemptsToday}</div>
        </div>
        <div className="card p-4">
          <div className="text-sm text-gray-600 mb-1">Last Successful Login</div>
          <div className="text-sm font-medium">
            {summary.lastSuccessfulLogin ? formatRelativeTime(summary.lastSuccessfulLogin) : 'Never'}
          </div>
          {summary.lastSuccessfulLogin && (
            <div className="text-xs text-gray-500" title={formatAbsoluteTime(summary.lastSuccessfulLogin)}>
              {formatAbsoluteTime(summary.lastSuccessfulLogin)}
            </div>
          )}
        </div>
      </div>

      {/* Activity Log */}
      <div className="card p-6">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-lg font-bold">Activity Log</h2>
          <select
            value={filter}
            onChange={(e) => setFilter(e.target.value as ActivityFilter)}
            className="px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-sky-500"
          >
            <option value="all">All Activity</option>
            <option value="logins">Logins Only</option>
            <option value="failures">Failures Only</option>
            <option value="admin_actions">Admin Actions</option>
          </select>
        </div>

        {filteredActivities.length === 0 ? (
          <div className="text-center py-8 text-gray-500">
            <p>No activity yet</p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="border-b">
                  <th className="text-left py-2 px-3 font-medium">Action</th>
                  <th className="text-left py-2 px-3 font-medium">Status</th>
                  <th className="text-left py-2 px-3 font-medium">Email</th>
                  <th className="text-left py-2 px-3 font-medium">IP Address</th>
                  <th className="text-left py-2 px-3 font-medium">Device</th>
                  <th className="text-left py-2 px-3 font-medium">Time</th>
                </tr>
              </thead>
              <tbody>
                {filteredActivities.map((activity) => {
                  const { browser, device } = parseUserAgent(activity.user_agent);
                  const isSuspicious = suspiciousIPs.includes(activity.ip_address);

                  return (
                    <tr
                      key={activity.id}
                      className={`border-b last:border-0 ${isSuspicious ? 'bg-red-50' : ''}`}
                    >
                      <td className="py-3 px-3">
                        <div className="flex items-center gap-2">
                          <span>{getActionIcon(activity.action)}</span>
                          <span className="truncate max-w-[200px]" title={activity.action}>
                            {activity.action}
                          </span>
                          {isSuspicious && (
                            <span className="px-2 py-0.5 text-xs bg-red-100 text-red-700 rounded-full">
                              ⚠️ Suspicious
                            </span>
                          )}
                        </div>
                      </td>
                      <td className="py-3 px-3">
                        <span
                          className={`px-2 py-1 text-xs rounded-full ${
                            activity.status === 'success'
                              ? 'bg-green-100 text-green-700'
                              : 'bg-red-100 text-red-700'
                          }`}
                        >
                          {activity.status}
                        </span>
                      </td>
                      <td className="py-3 px-3 text-gray-600 truncate max-w-[150px]">
                        {activity.email}
                      </td>
                      <td className="py-3 px-3 text-gray-600">
                        {activity.ip_address}
                      </td>
                      <td className="py-3 px-3 text-gray-600">
                        <div className="text-xs">
                          <div>{browser}</div>
                          <div className="text-gray-500">{device}</div>
                        </div>
                      </td>
                      <td className="py-3 px-3 text-gray-600">
                        <div title={formatAbsoluteTime(activity.created_at)}>
                          {formatRelativeTime(activity.created_at)}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

