  const heights = {
    banner: 'min-h-[90px]',
    square: 'min-h-[250px]',
    skyscraper: 'min-h-[600px]',
  };

  return (
    <div className="ad-wrap" data-ad-label={label}>
      <div className="ad-label">Advertisement</div>
      <div className={`ad-box ${heights[variant]}`}>
        <div dangerouslySetInnerHTML={{ __html: cleanCode }} />
      </div>
    </div>
  );
}
