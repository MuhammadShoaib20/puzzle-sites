            {levelList.length} levels ·{' '}
            <Link
              href={`/game/${game.slug}`}
              target="_blank"
              className="font-bold"
              style={{ color: 'var(--primary-dark)' }}
            >
              View public page →
            </Link>
          </p>
        </div>
        <Link href={`/ms-control-9x7k2p/games/${id}/levels/new`} className="btn btn-primary btn-sm">
          + Add single level
        </Link>
