/* Admin app chrome: sticky workspace header, module navigation, and account tools. */
.admin-shell {
  display: grid;
  grid-template-columns: 264px minmax(0, 1fr);
  grid-template-rows: 76px minmax(calc(100vh - 76px), auto);
  align-content: start;
  min-height: 100vh;
}
.admin-shell > .admin-topbar {
  position: sticky;
  z-index: 70;
  top: 0;
  grid-column: 1 / -1;
  grid-row: 1;
  display: grid;
  grid-template-columns: minmax(220px, 1fr) minmax(230px, 390px) auto auto;
  align-items: center;
  gap: clamp(0.75rem, 2vw, 1.5rem);
  width: 100%;
  min-height: 76px;
  padding: 0 clamp(1rem, 2.5vw, 2rem);
  border-bottom: 1px solid #E3E6F0;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}
.admin-topbar > .brand {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  color: #0F172A;
  text-decoration: none;
}
.admin-topbar .admin-header-brand {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  gap: 0.75rem;
}
.admin-topbar .brand-mark {
  display: grid;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  place-items: center;
  border: 0;
  border-radius: 13px;
  background: #5B5BD6;
  box-shadow: 0 6px 15px rgba(91, 91, 214, 0.2);
  color: #FFFFFF;
  font-size: 1.35rem;
}
.admin-topbar .admin-header-logo {
  width: auto;
  height: 42px;
  max-width: 58px;
  flex: 0 0 auto;
  object-fit: contain;
}
.admin-header-brand-copy {
  display: grid;
  min-width: 0;
  gap: 0.12rem;
}
.admin-header-brand-copy strong {
  overflow: hidden;
  color: #0F172A;
  font-size: 0.94rem;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.admin-header-brand-copy > span {
  color: #64748B;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.035em;
  line-height: 1.2;
