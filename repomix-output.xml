.admin-search-clear:hover { background: #EEF0FF; color: #4A4AC4; }
.admin-search-results {
  position: absolute;
  z-index: 90;
  top: calc(100% + 0.55rem);
  right: 0;
  left: 0;
  max-height: min(60vh, 420px);
