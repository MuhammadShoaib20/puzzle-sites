const ADSENSE_OPTIONS: sanitizeHtml.IOptions = {
  allowedTags: ['script', 'ins', 'div', 'span', 'iframe'],
  allowedAttributes: {
    script: ['async', 'src', 'crossorigin', 'data-ad-client'],
    ins: [
      'class',
