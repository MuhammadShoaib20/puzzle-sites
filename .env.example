# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site
NEXT_PUBLIC_SITE_URL=https://puzzlewalkthroughs.com
NEXT_PUBLIC_GSC_VERIFICATION=your_google_verification_code

# Admin Security
ADMIN_SECRET_PATH=replace_with_a_private_admin_path
ADMIN_ACCESS_KEY=replace_with_your_8_digit_admin_key

# Email Notifications (Optional)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bing Webmaster Tools credential encryption (32 random bytes, base64-encoded)
BING_CREDENTIALS_ENCRYPTION_KEY=generate_a_32_byte_base64_key

# IndexNow: copy the key printed by `npx nextjs-indexnow init`
INDEXNOW_KEY=your_generated_indexnow_key
INDEXNOW_SUBMIT=false