{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 10,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "includeEmptyDirectories": false,
    "git": {
      "sortByChanges": false,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "include": [
    "app/**/*.{ts,tsx,js,jsx,css}",
    "components/**/*.{ts,tsx,js,jsx,css}",
    "lib/**/*.{ts,tsx,js,jsx}",
    "types/**/*.{ts,tsx}",
    "public/**/*.{json,svg,ico,webmanifest}",
    "middleware.ts",
    "proxy.ts",
    "next.config.ts",
    "next.config.js",
    "postcss.config.mjs",
    "postcss.config.js",
    "tailwind.config.ts",
    "tailwind.config.js",
    "tsconfig.json",
    "package.json",
    "eslint.config.mjs",
    ".env.example",
    "supabase/**/*.{sql,md}"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/.env",
      "**/.env.local",
      "**/.env.*.local",
      "**/.env.production",
      "**/.env.development",
      "**/.next/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/.vercel/**",
      "**/.turbo/**",
      "**/coverage/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.DS_Store",
      "**/*.log",
      "**/npm-debug.log*",
      "**/yarn-debug.log*",
      "**/yarn-error.log*",
      "**/.pnpm-debug.log*",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/repomix-output.*",
      "**/repomix-output.xml",
      "**/repomix-output.txt",
      "**/repomix.config.json",
      "**/next-env.d.ts",
      "**/*.tsbuildinfo",
      "**/public/**/*.{png,jpg,jpeg,gif,webp,avif,ico,mp4,mp3,wav}",
      "**/.vscode/**",
      "**/.idea/**",
      "**/*.bak",
      "**/*.tmp",
      "**/*.swp",
      "**/supabase/.temp/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}